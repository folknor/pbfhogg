+#[derive(Clone, Copy)]
+pub(crate) enum DiffInfoField {
+    Version = 1,
+    Visible = 6,
+}
+
+/// Scan the whole message's framing to find the last occurrence of one
+/// scalar, as `WireInfo` does. Decode and check the selected varint's value.
+pub(crate) fn diff_info_scalar(data: Option<&[u8]>, field: DiffInfoField) -> Result<Option<u64>> {
+    use super::wire::{Cursor, WIRE_VARINT};
+
+    let mut cursor = Cursor::new(data.unwrap_or_default());
+    let mut value = None;
+    while let Some((number, wire_type)) = cursor.read_tag()? {
+        if number == field as u32 && wire_type == WIRE_VARINT {
+            value = Some(cursor.read_varint()?);
+        } else {
+            cursor.skip_field(wire_type)?;
+        }
+    }
+    Ok(value)
+}
