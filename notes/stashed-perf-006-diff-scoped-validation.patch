+    fn assert_matching_refusal<T>(
+        result: Result<T>,
+        full: &crate::Error,
+        source: &std::path::Path,
+    ) {
+        use crate::ErrorKind::{StringtableIndexOutOfBounds, WireFormat};
+
+        let Err(err) = result else {
+            panic!("indexed diff accepted input the full reader refused: {full}");
+        };
+        let matching = match (err.kind(), full.kind()) {
+            (WireFormat { msg: actual }, WireFormat { msg: expected }) => actual == expected,
+            (
+                StringtableIndexOutOfBounds { index: actual },
+                StringtableIndexOutOfBounds { index: expected },
+            ) => actual == expected,
+            _ => false,
+        };
+        assert!(matching, "expected {full}, got {err}");
+        assert_eq!(err.source_path(), Some(source));
+        assert!(err.blob_index().is_some());
+    }
