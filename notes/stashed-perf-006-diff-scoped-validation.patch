+/// Replay one dense output group forward, including the preceding deltas in
+/// that group. A group with no output does not need a replay.
+#[derive(Default)]
+pub(crate) struct OutputCursor<'a>(Option<Box<DenseOutput<'a>>>);
+
+struct DenseOutput<'a> {
+    group: usize,
+    next: usize,
+    nodes: crate::DenseNodeIter<'a>,
+}
+
+impl<'a> OutputCursor<'a> {
+    fn node(
+        &mut self,
+        block: &'a DiffOutputBlock,
+        group: usize,
+        slot: usize,
+        data: &'a [u8],
+        metadata: bool,
+    ) -> Result<crate::Element<'a>> {
+        if self.0.as_ref().is_none_or(|prior| prior.group != group) {
+            let nodes = block.dense(accepted(WireDenseNodes::parse(data)), metadata)?;
+            self.0 = Some(Box::new(DenseOutput {
+                group,
+                next: 0,
+                nodes,
+            }));
+        }
+        let output = self
+            .0
+            .as_mut()
+            .ok_or_else(|| crate::Error::internal("diff output cursor lost its group"))?;
+        let skip = slot
+            .checked_sub(output.next)
+            .ok_or_else(|| crate::Error::internal("diff output cursor moved backwards"))?;
+        let node = output.nodes.nth(skip).ok_or_else(|| {
+            crate::Error::internal("diff output cursor ended before the requested node")
+        })?;
+        output.next = slot + 1;
+        Ok(crate::Element::DenseNode(node))
     }
 }
 
