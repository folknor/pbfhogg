+/// Dense metadata columns align to the IDs. Count them before a version or
+/// visibility lookup can mistake a missing trailing value for an absent
+/// column, or a writer can replay deltas from an invalid column.
+pub(crate) fn diff_dense_info<'a>(dense: &WireDenseNodes<'a>) -> Result<Option<WireDenseInfo<'a>>> {
+    match dense.info_data {
+        Some(data) => validate_dense_info_arrays(data, packed_varint_count(dense.id_data)?),
+        None => Ok(None),
+    }
+}
