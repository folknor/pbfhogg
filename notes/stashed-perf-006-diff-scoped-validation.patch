+/// Reader backing for scoped diff output. Its tables come from an accepted
+/// comparison block. Only its fallible replay methods expose elements.
+pub(crate) struct DiffOutputBlock(BlockData);
+
+impl DiffOutputBlock {
+    /// The element messages stay in the comparison buffer. The writer's
+    /// reader backing needs only the validated strings and block scales.
+    #[allow(clippy::cast_possible_truncation)]
+    pub(crate) fn new(
+        payload: &[u8],
+        strings: &[(u32, u32)],
+        fields: super::wire::BlockFields,
+    ) -> Self {
+        let mut buffer = Vec::new();
+        let mut entries = Vec::with_capacity(strings.len());
+        for &(offset, len) in strings {
+            // The entire string table fits in the validated payload's
+            // u32 offset space. Its entries are disjoint within it.
+            entries.push((buffer.len() as u32, len));
+            let offset = offset as usize;
+            buffer.extend_from_slice(&payload[offset..offset + len as usize]);
+        }
+        let meta = WireBlock::inline_tables(&mut buffer, &entries, &[], fields);
+        Self(BlockData::new(Bytes::from(buffer), &meta))
+    }
+
+    /// The element's content has already passed the diff projection. Strip
+    /// Info for verbose text, which gets its version from the comparison row.
+    pub(crate) fn plain<'a>(
+        &'a self,
+        kind: crate::ElementKind,
+        data: &'a [u8],
+        metadata: bool,
+    ) -> Result<Element<'a>> {
+        let wire = &self.0.wire;
+        let info = |data: Option<&'a [u8]>| -> Result<Option<&'a [u8]>> {
+            if metadata {
+                validate_info(data)?;
+                Ok(data)
+            } else {
+                Ok(None)
+            }
+        };
+        Ok(match kind {
+            crate::ElementKind::Node => {
+                let mut node = WireNode::parse(data)?;
+                node.info_data = info(node.info_data)?;
+                Element::Node(Node::new(wire, node))
+            }
+            crate::ElementKind::Way => {
+                let mut way = WireWay::parse(data)?;
+                way.info_data = info(way.info_data)?;
+                Element::Way(Way::new(wire, way))
+            }
+            crate::ElementKind::Relation => {
+                let mut relation = WireRelation::parse(data)?;
+                relation.info_data = info(relation.info_data)?;
+                Element::Relation(Relation::new(wire, relation))
+            }
+        })
+    }
+
+    pub(crate) fn dense<'a>(
+        &'a self,
+        dense: WireDenseNodes<'a>,
+        metadata: bool,
+    ) -> Result<DenseNodeIter<'a>> {
+        let wire = &self.0.wire;
+        if metadata {
+            diff_dense_info(&dense)?;
+            Ok(DenseNodeIter::new(wire, dense))
+        } else {
+            Ok(DenseNodeIter::new_skip_metadata(wire, dense))
+        }
+    }
+}
