+    /// The old dense encoder staged signed deltas and packed each field at
+    /// flush before building DenseInfo, DenseNodes and PrimitiveGroup.
+    #[derive(Default)]
+    struct StagedDenseNodes {
+        ids: Vec<i64>,
+        lats: Vec<i64>,
+        lons: Vec<i64>,
+        keys_vals: Vec<i32>,
+        versions: Vec<i32>,
+        timestamps: Vec<i64>,
+        changesets: Vec<i64>,
+        uids: Vec<i32>,
+        users: Vec<i32>,
+        visibles: Vec<bool>,
+        previous_position: [i64; 3],
+        previous_meta: Option<RawMetadata>,
+    }
+
+    impl StagedDenseNodes {
+        fn push(
+            &mut self,
+            id: i64,
+            lat: i32,
+            lon: i32,
+            tags: &[(u32, u32)],
+            meta: Option<RawMetadata>,
+        ) {
+            if !tags.is_empty() && self.keys_vals.is_empty() {
+                self.keys_vals.resize(self.ids.len(), 0);
+            }
+            for &(key, value) in tags {
+                self.keys_vals
+                    .extend([key.cast_signed(), value.cast_signed()]);
+            }
+            if !self.keys_vals.is_empty() {
+                self.keys_vals.push(0);
+            }
