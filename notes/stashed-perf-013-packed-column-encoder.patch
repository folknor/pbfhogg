+/// The packed bodies of a single dense run, with deltas accumulated as
+/// nodes are added. `count` is independent of the byte lengths and lets the
+/// first tagged node pad the omitted tag column for earlier tagless nodes.
+#[derive(Clone)]
+struct PackedDenseNodes {
+    ids: Vec<u8>,
+    lats: Vec<u8>,
+    lons: Vec<u8>,
+    keys_vals: Vec<u8>,
+    versions: Vec<u8>,
+    timestamps: Vec<u8>,
+    changesets: Vec<u8>,
+    uids: Vec<u8>,
+    user_sids: Vec<u8>,
+    visibles: Vec<u8>,
+    count: usize,
+    last_id: i64,
+    last_lat: i64,
+    last_lon: i64,
+    last_timestamp: i64,
+    last_changeset: i64,
+    last_uid: i32,
+    last_user_sid: i32,
+}
+
+struct DenseGroupLengths {
+    info: usize,
+    dense: usize,
+    group: usize,
+    total: usize,
+}
+
+impl PackedDenseNodes {
+    fn with_capacity(prealloc: usize) -> Self {
+        Self {
+            ids: Vec::with_capacity(prealloc),
+            lats: Vec::with_capacity(prealloc),
+            lons: Vec::with_capacity(prealloc),
+            // Preserve the historical reservation for mixed tag runs.
+            keys_vals: Vec::with_capacity(prealloc.saturating_mul(2)),
+            versions: Vec::with_capacity(prealloc),
+            timestamps: Vec::with_capacity(prealloc),
+            changesets: Vec::with_capacity(prealloc),
+            uids: Vec::with_capacity(prealloc),
+            user_sids: Vec::with_capacity(prealloc),
+            visibles: Vec::with_capacity(prealloc),
+            count: 0,
+            last_id: 0,
+            last_lat: 0,
+            last_lon: 0,
+            last_timestamp: 0,
+            last_changeset: 0,
+            last_uid: 0,
+            last_user_sid: 0,
+        }
+    }
+
+    #[inline]
+    fn push_position(&mut self, id: i64, lat: i32, lon: i32) {
+        push_delta(&mut self.ids, id, &mut self.last_id);
+        push_delta(&mut self.lats, i64::from(lat), &mut self.last_lat);
+        push_delta(&mut self.lons, i64::from(lon), &mut self.last_lon);
+        self.count += 1;
+    }
+
+    #[inline]
+    fn push_tag(&mut self, preceding: usize, key: u32, value: u32) {
+        if self.keys_vals.is_empty() {
+            self.keys_vals.resize(preceding, 0);
+        }
+        encode_varint(
+            &mut self.keys_vals,
+            i64::from(key.cast_signed()).cast_unsigned(),
+        );
+        encode_varint(
+            &mut self.keys_vals,
+            i64::from(value.cast_signed()).cast_unsigned(),
+        );
+    }
+
+    #[inline]
+    fn finish_tags(&mut self) {
+        if !self.keys_vals.is_empty() {
+            self.keys_vals.push(0);
+        }
+    }
+
+    fn push_metadata(&mut self, meta: &RawMetadata) {
+        // Keep the full-metadata add path branch-free. The run's column
+        // set controls which packed columns are used when it is sealed.
+        encode_varint(&mut self.versions, i64::from(meta.version).cast_unsigned());
+        push_delta(
+            &mut self.timestamps,
+            meta.timestamp,
+            &mut self.last_timestamp,
+        );
+        push_delta(
+            &mut self.changesets,
+            meta.changeset,
+            &mut self.last_changeset,
+        );
+        encode_varint(
+            &mut self.uids,
+            u64::from(zigzag_encode_32(meta.uid.wrapping_sub(self.last_uid))),
+        );
+        self.last_uid = meta.uid;
+        encode_varint(
+            &mut self.user_sids,
+            u64::from(zigzag_encode_32(
+                meta.user_sid.wrapping_sub(self.last_user_sid),
+            )),
+        );
+        self.last_user_sid = meta.user_sid;
+        self.visibles.push(u8::from(meta.visible));
+    }
+
+    fn info_fields(&self, columns: DenseColumns) -> impl Iterator<Item = (u32, &[u8])> {
+        [
+            (columns.version(), 1, self.versions.as_slice()),
+            (columns.timestamp(), 2, self.timestamps.as_slice()),
+            (columns.changeset(), 3, self.changesets.as_slice()),
+            (columns.uid(), 4, self.uids.as_slice()),
+            (columns.user(), 5, self.user_sids.as_slice()),
+            (columns.visible(), 6, self.visibles.as_slice()),
+        ]
+        .into_iter()
+        .filter_map(|(present, field, bytes)| present.then_some((field, bytes)))
+    }
+
+    fn tail_fields(&self) -> [(u32, &[u8]); 3] {
+        [(8, &self.lats), (9, &self.lons), (10, &self.keys_vals)]
+    }
+
+    fn lengths(&self, columns: DenseColumns) -> Result<DenseGroupLengths> {
+        let overflow = || crate::error::Error::internal("dense node group length overflows usize");
+        let info = nonempty_fields_len(self.info_fields(columns).map(|(_, bytes)| bytes.len()))
+            .ok_or_else(overflow)?;
+        let dense = nonempty_fields_len(
+            [self.ids.len(), info]
+                .into_iter()
+                .chain(self.tail_fields().map(|(_, bytes)| bytes.len())),
+        )
+        .ok_or_else(overflow)?;
+        let group = len_field_size(dense).ok_or_else(overflow)?;
+        let total = len_field_size(group).ok_or_else(overflow)?;
+        Ok(DenseGroupLengths {
+            info,
+            dense,
+            group,
+            total,
+        })
+    }
+
+    fn encode_to(
+        &self,
+        buf: &mut Vec<u8>,
+        columns: DenseColumns,
+        lengths: &DenseGroupLengths,
+    ) -> Result<()> {
+        buf.reserve(lengths.total);
+        let start = buf.len();
+        write_len_prefix(buf, 2, lengths.group);
+        write_len_prefix(buf, 2, lengths.dense);
+        encode_bytes_field(buf, 1, &self.ids);
+        if lengths.info != 0 {
+            write_len_prefix(buf, 5, lengths.info);
+            for (field, bytes) in self.info_fields(columns) {
+                encode_bytes_field(buf, field, bytes);
+            }
+        }
+        for (field, bytes) in self.tail_fields() {
+            encode_bytes_field(buf, field, bytes);
+        }
+        if buf.len() - start != lengths.total {
+            return Err(crate::error::Error::internal(
+                "dense node group lengths do not match packed columns",
+            ));
+        }
+        Ok(())
+    }
+
+    fn buffers(&mut self) -> [&mut Vec<u8>; 10] {
+        [
+            &mut self.ids,
+            &mut self.lats,
+            &mut self.lons,
+            &mut self.keys_vals,
+            &mut self.versions,
+            &mut self.timestamps,
+            &mut self.changesets,
+            &mut self.uids,
+            &mut self.user_sids,
+            &mut self.visibles,
+        ]
+    }
+
+    fn clear(&mut self) {
+        for buf in self.buffers() {
+            buf.clear();
+        }
+        self.count = 0;
+        self.last_id = 0;
+        self.last_lat = 0;
+        self.last_lon = 0;
+        self.last_timestamp = 0;
+        self.last_changeset = 0;
+        self.last_uid = 0;
+        self.last_user_sid = 0;
+    }
+}
+
+fn nonempty_fields_len(lengths: impl IntoIterator<Item = usize>) -> Option<usize> {
+    lengths
+        .into_iter()
+        .filter(|&len| len != 0)
+        .try_fold(0usize, |sum, len| sum.checked_add(len_field_size(len)?))
+}
