+        fn append_group(&self, groups: &mut Vec<u8>, columns: crate::DenseColumns) {
+            use protohoggr::{
+                encode_packed_bool, encode_packed_int32, encode_packed_sint32, encode_packed_sint64,
+            };
+
+            let (mut packed, mut info, mut dense, mut group) =
+                (Vec::new(), Vec::new(), Vec::new(), Vec::new());
+            encode_packed_sint64(&mut dense, &mut packed, 1, &self.ids);
+            if columns.version() {
+                encode_packed_int32(&mut info, &mut packed, 1, &self.versions);
+            }
+            if columns.timestamp() {
+                encode_packed_sint64(&mut info, &mut packed, 2, &self.timestamps);
+            }
+            if columns.changeset() {
+                encode_packed_sint64(&mut info, &mut packed, 3, &self.changesets);
+            }
+            if columns.uid() {
+                encode_packed_sint32(&mut info, &mut packed, 4, &self.uids);
+            }
+            if columns.user() {
+                encode_packed_sint32(&mut info, &mut packed, 5, &self.users);
+            }
+            if columns.visible() {
+                encode_packed_bool(&mut info, 6, &self.visibles);
+            }
+            encode_bytes_field(&mut dense, 5, &info);
+            encode_packed_sint64(&mut dense, &mut packed, 8, &self.lats);
+            encode_packed_sint64(&mut dense, &mut packed, 9, &self.lons);
+            encode_packed_int32(&mut dense, &mut packed, 10, &self.keys_vals);
