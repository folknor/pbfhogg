+    fn staged_plain_node(group: &mut Vec<u8>, id: i64, lat: i32, info: &[u8]) {
+        use protohoggr::{WIRE_VARINT, encode_tag, encode_varint, zigzag_encode_64};
+        let mut node = Vec::new();
+        encode_tag(&mut node, 1, WIRE_VARINT);
+        encode_varint(&mut node, zigzag_encode_64(id));
+        encode_bytes_field(&mut node, 4, info);
+        for (field, value) in [(8, i64::from(lat)), (9, 0)] {
+            encode_tag(&mut node, field, WIRE_VARINT);
+            encode_varint(&mut node, zigzag_encode_64(value));
+        }
+        encode_bytes_field(group, 1, &node);
+    }
