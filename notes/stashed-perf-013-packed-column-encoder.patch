+/// One span per length-delimited element field, in wire order. Fields 8-10
+/// are refs/lat/lon for ways and roles/member IDs/types for relations.
+const ELEMENT_FIELDS: [u32; 6] = [2, 3, 4, 8, 9, 10];
+
+#[derive(Clone)]
+struct ElementSpans {
+    id_len: usize,
+    lengths: [usize; ELEMENT_FIELDS.len()],
+    body_len: usize,
+}
+
+/// Store each element's packed spans in reusable, contiguous field buffers.
+/// At flush, the spans are read in element order into the final block. Each
+/// span is copied once, with its length already known. An arena per field
+/// avoids both an allocation per element and moving bytes to backpatch prefixes.
+#[derive(Clone, Default)]
+pub(super) struct ElementGroup {
+    // Complete int64 ID fields, including their tags.
+    ids: Vec<u8>,
+    columns: [Vec<u8>; ELEMENT_FIELDS.len()],
+    elements: Vec<ElementSpans>,
+    body_len: usize,
+}
+
+impl ElementGroup {
+    pub(super) fn len(&self) -> usize {
+        self.body_len
+    }
+
+    pub(super) fn clear(&mut self, retention_limit: usize) {
+        self.body_len = 0;
+        clear_or_release(&mut self.elements, retention_limit);
+        clear_or_release(&mut self.ids, retention_limit);
+        for column in &mut self.columns {
+            clear_or_release(column, retention_limit);
+        }
+    }
+
+    fn starts(&self) -> [usize; ELEMENT_FIELDS.len()] {
+        self.columns.each_ref().map(Vec::len)
+    }
+
+    fn start_element<'t, M: EncodeMetadata>(
+        &mut self,
+        strings: &mut StringTable,
+        tag_keys: &mut KeySet,
+        tags: impl IntoIterator<Item = (&'t str, &'t str)>,
+        metadata: Option<&M>,
+    ) -> [usize; ELEMENT_FIELDS.len()] {
+        let starts = self.starts();
+        let [keys, values, info, ..] = &mut self.columns;
+        for (key, value) in tags {
+            let key = strings.add(key);
+            tag_keys.insert(key);
+            encode_varint(keys, u64::from(key));
+            encode_varint(values, u64::from(strings.add(value)));
+        }
+        if let Some(meta) = metadata {
+            meta.append_info(info, strings);
+        }
+        starts
+    }
+
+    fn finish_element(&mut self, id: i64, starts: [usize; ELEMENT_FIELDS.len()]) {
+        let lengths = std::array::from_fn(|i| self.columns[i].len() - starts[i]);
+        let id_start = self.ids.len();
+        encode_int64_field_always(&mut self.ids, 1, id);
+        let id_len = self.ids.len() - id_start;
+        let mut body_len = id_len;
+        for len in lengths {
+            if len != 0 {
+                body_len += 1 + varint_len(len as u64) + len;
+            }
+        }
+        self.body_len += 1 + varint_len(body_len as u64) + body_len;
+        self.elements.push(ElementSpans {
+            id_len,
+            lengths,
+            body_len,
+        });
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn add_way<'t, M: EncodeMetadata>(
+        &mut self,
+        strings: &mut StringTable,
+        tag_keys: &mut KeySet,
+        id: i64,
+        tags: impl IntoIterator<Item = (&'t str, &'t str)>,
+        refs: &[i64],
+        locations: Option<&[(i32, i32)]>,
+        metadata: Option<&M>,
+    ) {
+        let starts = self.start_element(strings, tag_keys, tags, metadata);
+        let [.., ref_bytes, lat_bytes, lon_bytes] = &mut self.columns;
+        let mut last_ref = 0;
+        if let Some(locations) = locations {
+            let (mut last_lat, mut last_lon) = (0, 0);
+            for (&node, &(lat, lon)) in refs.iter().zip(locations) {
+                push_delta(ref_bytes, node, &mut last_ref);
+                push_delta(lat_bytes, i64::from(lat), &mut last_lat);
+                push_delta(lon_bytes, i64::from(lon), &mut last_lon);
+            }
+        } else {
+            for &node in refs {
+                push_delta(ref_bytes, node, &mut last_ref);
+            }
+        }
+        self.finish_element(id, starts);
+    }
+
+    pub(super) fn add_relation<'t, M: EncodeMetadata>(
+        &mut self,
+        strings: &mut StringTable,
+        tag_keys: &mut KeySet,
+        id: i64,
+        tags: impl IntoIterator<Item = (&'t str, &'t str)>,
+        members: &[MemberData<'_>],
+        metadata: Option<&M>,
+    ) {
+        let starts = self.start_element(strings, tag_keys, tags, metadata);
+        let mut last_id = 0;
+        for &member in members {
+            self.push_member(strings, member, member.id.member_type(), &mut last_id);
+        }
+        self.finish_element(id, starts);
+    }
+
+    pub(super) fn add_relation_iter<'t, 'm, M: EncodeMetadata>(
+        &mut self,
+        strings: &mut StringTable,
+        tag_keys: &mut KeySet,
+        id: i64,
+        tags: impl IntoIterator<Item = (&'t str, &'t str)>,
+        members: impl IntoIterator<Item = crate::error::Result<MemberData<'m>>>,
+        metadata: Option<&M>,
+    ) -> crate::error::Result<()> {
+        let starts = self.start_element(strings, tag_keys, tags, metadata);
+        if let Err(err) = self.pack_members(strings, id, members) {
+            for (column, start) in self.columns.iter_mut().zip(starts) {
+                column.truncate(start);
+            }
+            return Err(err);
+        }
+        self.finish_element(id, starts);
+        Ok(())
+    }
+
+    fn pack_members<'m>(
+        &mut self,
+        strings: &mut StringTable,
+        id: i64,
+        members: impl IntoIterator<Item = crate::error::Result<MemberData<'m>>>,
+    ) -> crate::error::Result<()> {
+        let mut last_id = 0;
+        let mut unknown = None;
+        for member in members {
+            let member = member?;
+            let kind = member.id.member_type();
+            if let crate::MemberType::Unknown(raw) = kind {
+                unknown.get_or_insert(raw);
+                continue;
+            }
+            self.push_member(strings, member, kind, &mut last_id);
+        }
+        if let Some(raw) = unknown {
+            return Err(crate::error::Error::invalid_data(format!(
+                "relation {id}: member type {raw} has no Relation.MemberType enum \
+                 value; encoding it would rewrite the member as a node",
+            )));
+        }
+        Ok(())
+    }
+
+    #[inline]
+    fn push_member(
+        &mut self,
+        strings: &mut StringTable,
+        member: MemberData<'_>,
+        kind: crate::MemberType,
+        last_id: &mut i64,
+    ) {
+        let [.., roles, ids, types] = &mut self.columns;
+        let role = strings.add(member.role).cast_signed();
+        encode_varint(roles, i64::from(role).cast_unsigned());
+        push_delta(ids, member.id.id(), last_id);
+        types.push(member_type_value(kind));
+    }
+
+    pub(super) fn add_raw(&mut self, id: i64, fields: [&[u8]; ELEMENT_FIELDS.len()]) {
+        let starts = self.starts();
+        for (column, bytes) in self.columns.iter_mut().zip(fields) {
+            column.extend_from_slice(bytes);
+        }
+        self.finish_element(id, starts);
+    }
+
+    pub(super) fn encode_to(&self, buf: &mut Vec<u8>, field: u32) -> crate::error::Result<()> {
+        if self.elements.is_empty() {
+            return Ok(());
+        }
+        let total = len_field_size(self.body_len)
+            .ok_or_else(|| crate::error::Error::internal("element group length overflows usize"))?;
+        buf.reserve(total);
+        let start = buf.len();
+        write_len_prefix(buf, 2, self.body_len);
+        let mut ids = self.ids.as_slice();
+        let mut remaining = self.columns.each_ref().map(Vec::as_slice);
+        for element in &self.elements {
+            write_len_prefix(buf, field, element.body_len);
+            buf.extend_from_slice(take_span(&mut ids, element.id_len)?);
+            for ((field, len), remaining) in ELEMENT_FIELDS
+                .into_iter()
+                .zip(element.lengths)
+                .zip(&mut remaining)
+            {
+                if len == 0 {
+                    continue;
+                }
+                encode_bytes_field_always(buf, field, take_span(remaining, len)?);
+            }
+        }
+        if buf.len() - start != total
+            || !ids.is_empty()
+            || remaining.iter().any(|span| !span.is_empty())
+        {
+            return Err(crate::error::Error::internal(
+                "element group lengths do not match packed spans",
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[inline]
+fn take_span<'a>(remaining: &mut &'a [u8], len: usize) -> crate::error::Result<&'a [u8]> {
+    let (span, rest) = remaining
+        .split_at_checked(len)
+        .ok_or_else(|| crate::error::Error::internal("element span exceeds its packed column"))?;
+    *remaining = rest;
+    Ok(span)
+}
+
+fn clear_or_release<T>(buf: &mut Vec<T>, limit: usize) {
+    if buf.capacity().saturating_mul(std::mem::size_of::<T>()) > limit {
+        // Release the oversized allocation, not just its contents.
+        drop(std::mem::take(buf));
+    } else {
+        buf.clear();
+    }
+}
+
+#[inline]
+pub(super) fn push_delta(buf: &mut Vec<u8>, value: i64, last: &mut i64) {
+    encode_varint(buf, zigzag_encode_64(value.wrapping_sub(*last)));
+    *last = value;
+}
