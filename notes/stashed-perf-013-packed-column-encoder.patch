+            let [id, lat, lon] =
+                std::array::from_fn(|i| position[i].wrapping_sub(self.previous_position[i]));
+            self.ids.push(id);
+            self.lats.push(lat);
+            self.lons.push(lon);
+            self.previous_position = position;
+            if let Some(meta) = meta {
+                self.versions.push(meta.version);
+                self.timestamps.push(
+                    meta.timestamp
+                        .wrapping_sub(self.previous_meta.map_or(0, |m| m.timestamp)),
+                );
+                self.changesets.push(
+                    meta.changeset
+                        .wrapping_sub(self.previous_meta.map_or(0, |m| m.changeset)),
+                );
+                self.uids.push(
+                    meta.uid
+                        .wrapping_sub(self.previous_meta.map_or(0, |m| m.uid)),
+                );
+                self.users.push(
+                    meta.user_sid
+                        .wrapping_sub(self.previous_meta.map_or(0, |m| m.user_sid)),
+                );
+                self.visibles.push(meta.visible);
+                self.previous_meta = Some(meta);
+            }
+        }
