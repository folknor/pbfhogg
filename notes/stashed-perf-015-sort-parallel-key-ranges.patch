index 00000000..939efb06
--- /dev/null
+++ b/crates/lib/src/commands/blob_merge/sweep/ranges.rs
@@ -0,0 +1,613 @@
+//! Large sort components are decoded into runs of packed records, one per
+//! input frame. Each run has a fixed-width index sorted by (ID, version,
+//! occurrence) and a separate arena for the bodies and frame dictionary.
+//! The ranges share those runs by slicing the index at ID boundaries.
+//!
+//! The spill is immutable once mapped. A worker keeps one heap head per
+//! intersecting run and materializes one body at a time. The scheduler only
+//! keeps descriptors for pending splits and for the ordered pool's window.
+
+use std::cmp::Reverse;
+use std::collections::BinaryHeap;
+use std::io::{BufWriter, Write};
+use std::num::NonZeroUsize;
+use std::ops::Range;
+use std::path::Path;
+
+use super::{Check, Chunk, Output, RunCounts, borrowed_version, of_kind};
+use crate::commands::blob_merge::{FrameBuf, Plan, PlanWriter, Run, Sources, read_block};
+use crate::host::{Entered, Recorder};
+use crate::ordered_pool::{self, ConsumeFn, Emitter, PoolConfig, StreamConfig, StreamConsumer};
+use crate::osm_id::{osm_id_from_ordinal, osm_id_ordinal};
+use crate::scratch::{RunScratch, ScratchFile};
+use crate::tunables::{
+    DEFAULT_ELEMENT_CAP, OVERLAP_RUN_CHANNEL_DEPTH, SORT_RANGE_TARGET_BYTES,
+    SWEEP_CHECKPOINT_REMOVALS,
+};
+use crate::write::metrics::WriterMetrics;
+use crate::writer::Compression;
+use crate::{ElementKind, Error, Result};
+
+mod record;
+
+#[derive(Clone, Copy)]
+pub(in crate::commands) struct Config<'a> {
+    pub(in crate::commands) parent: &'a Path,
+    pub(in crate::commands) min_records: u64,
+    pub(in crate::commands) target_records: u64,
+}
+
+const INDEX_BYTES: usize = 16;
+type IndexBytes = [u8; INDEX_BYTES];
+
+#[derive(Clone, Copy)]
+struct Key {
+    ordinal: u64,
+    version: i32,
+    /// The record's position before sorting, then its byte offset in the body arena.
+    offset: u32,
+}
+
+impl Key {
+    fn encode(self) -> IndexBytes {
+        let mut bytes = [0; INDEX_BYTES];
+        bytes[..8].copy_from_slice(&self.ordinal.to_le_bytes());
+        bytes[8..12].copy_from_slice(&self.version.to_le_bytes());
+        bytes[12..].copy_from_slice(&self.offset.to_le_bytes());
+        bytes
+    }
+
+    fn decode(bytes: &IndexBytes) -> Self {
+        let words = bytes.as_chunks::<4>().0;
+        Self {
+            ordinal: u64::from(u32::from_le_bytes(words[0]))
+                | (u64::from(u32::from_le_bytes(words[1])) << 32),
+            version: i32::from_le_bytes(words[2]),
+            offset: u32::from_le_bytes(words[3]),
+        }
+    }
+}
+
+struct Prepared {
+    keys: Vec<IndexBytes>,
+    bodies: Vec<u8>,
+    strings: Vec<u8>,
+    frame: usize,
+    // A dense version below -1 with a rounded-to-zero timestamp may sort
+    // differently after the old sweep demotes it. Preserve its schedule.
+    needs_legacy: bool,
+}
+
+fn prepare(
+    plan: &Plan,
+    sources: &Sources,
+    run: &Run,
+    entry_index: usize,
+    buf: &mut FrameBuf,
+    cancel: &Recorder,
+) -> Result<Prepared> {
+    let entry = &plan.entries[entry_index];
+    let frame = &plan.frames[entry.frame];
+    let source = &sources[frame.source];
+    let block = read_block(source, frame, buf, cancel)?;
+    let build = || -> Result<Prepared> {
+        let believed = !entry.index_scanned;
+        if believed {
+            block.refuse_foreign_kind(Some(entry.index.kind))?;
+        }
+        let mut check = Check {
+            claim: believed.then_some(entry.index),
+            tally: Default::default(),
+            last: None,
+            ordered: !entry.intra_unsorted && !entry.restructured,
+        };
+        let mut bodies = record::Bodies::default();
+        let mut keys = Vec::new();
+        let mut positions = Vec::new();
+        let mut needs_legacy = false;
+        for elem in block.elements().filter(|e| of_kind(e, run.kind)) {
+            let id = super::element_id(&elem);
+            check.visit(id)?;
+            let version = borrowed_version(&elem);
+            let record = body_offset(keys.len())?;
+            positions.push(body_offset(bodies.bytes.len())?);
+            keys.push(Key {
+                ordinal: osm_id_ordinal(id),
+                version,
+                offset: record,
+            });
+            needs_legacy |= bodies.push(&elem, plan.keep_locations)?;
+            if keys.len().is_multiple_of(SWEEP_CHECKPOINT_REMOVALS) {
+                cancel.check()?;
+            }
+        }
+        check.finish()?;
+        positions.push(body_offset(bodies.bytes.len())?);
+        order_run(&mut keys, &positions, &mut bodies.bytes, cancel)?;
+        Ok(Prepared {
+            keys: keys.into_iter().map(Key::encode).collect(),
+            bodies: bodies.bytes,
+            strings: bodies.strings,
+            frame: entry.frame,
+            needs_legacy,
+        })
+    };
+    build().map_err(|e| source.locate_at(frame.file_offset, e))
+}
+
+fn body_offset(n: usize) -> Result<u32> {
+    u32::try_from(n).map_err(|_| Error::internal("one sort run body arena exceeds 4 GiB"))
+}
+
+fn order_run(
+    keys: &mut [Key],
+    positions: &[u32],
+    bodies: &mut Vec<u8>,
+    cancel: &Recorder,
+) -> Result<()> {
+    let order = |key: &Key| (key.ordinal, key.version, key.offset);
+    if keys.is_sorted_by_key(order) {
+        for (key, &position) in keys.iter_mut().zip(positions) {
+            key.offset = position;
+        }
+        return Ok(());
+    }
+    keys.sort_unstable_by_key(order);
+    // Store bodies in key order too, so each range reads just one span of
+    // each frame even when all of the original frame's IDs were scrambled.
+    let mut ordered = Vec::with_capacity(bodies.len());
+    for (i, key) in keys.iter_mut().enumerate() {
+        let record = key.offset as usize;
+        key.offset = body_offset(ordered.len())?;
+        ordered
+            .extend_from_slice(&bodies[positions[record] as usize..positions[record + 1] as usize]);
+        if i.is_multiple_of(SWEEP_CHECKPOINT_REMOVALS) {
+            cancel.check()?;
+        }
+    }
+    *bodies = ordered;
+    Ok(())
+}
+
+/// The bounded views of one source frame in the finished spill.
+struct FrameRun {
+    bodies: Range<usize>,
+    strings: Range<usize>,
+    index: Range<usize>,
+    frame: usize,
+}
+
+impl FrameRun {
+    fn keys<'a>(&self, mapped: &'a [u8]) -> &'a [IndexBytes] {
+        // The writer appends an integral number of fixed-width keys.
+        mapped[self.index.clone()].as_chunks::<INDEX_BYTES>().0
+    }
+
+    fn body<'a>(&self, mapped: &'a [u8], offset: u32, end: usize) -> Result<&'a [u8]> {
+        let bytes = &mapped[self.bodies.clone()];
+        bytes
+            .get(offset as usize..end)
+            .ok_or_else(|| Error::internal("sort run record length exceeds its arena"))
+    }
+}
+
+struct Spill {
+    file: BufWriter<ScratchFile>,
+    runs: Vec<FrameRun>,
+    size: usize,
+    needs_legacy: bool,
+}
+
+impl Spill {
+    fn append(&mut self, bytes: &[u8]) -> Result<Range<usize>> {
+        let start = self.size;
+        self.size = start
+            .checked_add(bytes.len())
+            .ok_or_else(|| Error::internal("sort run spill exceeds address space"))?;
+        self.file.write_all(bytes)?;
+        Ok(start..self.size)
+    }
+
+    fn push(&mut self, prepared: &Prepared) -> Result<()> {
+        self.needs_legacy |= prepared.needs_legacy;
+        if prepared.keys.is_empty() || self.needs_legacy {
+            return Ok(());
+        }
+        let bodies = self.append(&prepared.bodies)?;
+        let strings = self.append(&prepared.strings)?;
+        let index = self.append(prepared.keys.as_flattened())?;
+        self.runs.push(FrameRun {
+            bodies,
+            strings,
+            index,
+            frame: prepared.frame,
+        });
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Slice<'a> {
+    run: &'a FrameRun,
+    keys: &'a [IndexBytes],
+    body_end: usize,
+}
+
+struct Work<'a> {
+    slices: Vec<Slice<'a>>,
+    count: u64,
+    bytes: usize,
+}
+
+impl<'a> Work<'a> {
+    fn new(slices: Vec<Slice<'a>>) -> Self {
+        let (count, bytes) = slices.iter().fold((0, 0), |(count, bytes), slice| {
+            let offset = Key::decode(&slice.keys[0]).offset as usize;
+            (
+                count + slice.keys.len() as u64,
+                bytes + (slice.body_end - offset),
+            )
+        });
+        Self {
+            slices,
+            count,
+            bytes,
+        }
+    }
+
+    fn split(self) -> std::result::Result<(Self, Self), Self> {
+        let min = self
+            .slices
+            .iter()
+            .map(|s| Key::decode(&s.keys[0]).ordinal)
+            .min();
+        let max = self
+            .slices
+            .iter()
+            .filter_map(|s| s.keys.last().map(Key::decode))
+            .map(|key| key.ordinal)
+            .max();
+        let (Some(min), Some(max)) = (min, max) else {
+            return Err(self);
+        };
+        if min == max {
+            return Err(self);
+        }
+        // An exclusive upper bound for the left range. Even at a signed ID
+        // extreme the cut is between distinct keys and both sides advance.
+        let cut = min + (max - min).div_ceil(2);
+        let mut left = Vec::new();
+        let mut right = Vec::new();
+        for slice in self.slices {
+            let at = slice
+                .keys
+                .partition_point(|key| Key::decode(key).ordinal < cut);
+            let (before, after) = slice.keys.split_at(at);
+            if !before.is_empty() {
+                left.push(Slice {
+                    keys: before,
+                    body_end: after
+                        .first()
+                        .map_or(slice.body_end, |key| Key::decode(key).offset as usize),
+                    ..slice
+                });
+            }
+            if !after.is_empty() {
+                right.push(Slice {
+                    keys: after,
+                    ..slice
+                });
+            }
+        }
+        Ok((Self::new(left), Self::new(right)))
+    }
+}
+
+struct Schedule<'a> {
+    pending: Vec<Work<'a>>,
+    target: u64,
+    ordinal: u64,
+}
+
+impl<'a> Schedule<'a> {
+    fn next(&mut self, cancel: &Recorder) -> Result<Option<(u64, Work<'a>)>> {
+        while let Some(work) = self.pending.pop() {
+            cancel.check()?;
+            let work = if work.count > self.target || work.bytes > SORT_RANGE_TARGET_BYTES {
+                match work.split() {
+                    Ok((left, right)) => {
+                        self.pending.push(right);
+                        self.pending.push(left);
+                        continue;
+                    }
+                    Err(one_id) => one_id,
+                }
+            } else {
+                work
+            };
+            let start = self.ordinal;
+            self.ordinal += work.count;
+            return Ok(Some((start, work)));
+        }
+        Ok(None)
+    }
+}
+
+struct MergeRanges<'a> {
+    mapped: &'a [u8],
+    frames: &'a [super::Frame],
+    sources: &'a Sources,
+    kind: ElementKind,
+    keep_locations: bool,
+    compression: &'a Compression,
+    metrics: &'a WriterMetrics,
+    cancel: &'a Recorder,
+}
+
+impl MergeRanges<'_> {
+    fn merge(
+        &self,
+        (start, work): (u64, Work<'_>),
+        emitter: &Emitter<'_, Chunk, RunCounts>,
+    ) -> Result<RunCounts> {
+        let mut slices = work.slices;
+        let mut heap = BinaryHeap::with_capacity(slices.len());
+        for (slot, slice) in slices.iter().enumerate() {
+            self.offer(&mut heap, slot, slice);
+        }
+        let mut output = Output::new(self.keep_locations, self.compression, self.metrics);
+        let mut scratch = record::EncodeScratch::default();
+        let mut elements = 0u64;
+        let cap = DEFAULT_ELEMENT_CAP.get() as u64;
+        // Rejoin the original count boundaries after the block cut in two by
+        // a range boundary. Ranges starting on a boundary need no adjustment.
+        let first_flush = cap - start % cap;
+        while let Some(Reverse((ordinal, _, _, _, slot))) = heap.pop() {
+            let slice = &mut slices[slot];
+            let key = Key::decode(&slice.keys[0]);
+            slice.keys = &slice.keys[1..];
+            let end = slice
+                .keys
+                .first()
+                .map_or(slice.body_end, |key| Key::decode(key).offset as usize);
+            let frame = &self.frames[slice.run.frame];
+            let here = (frame.source, frame.file_offset);
+            scratch
+                .write(
+                    slice.run.body(self.mapped, key.offset, end)?,
+                    &self.mapped[slice.run.strings.clone()],
+                    self.kind,
+                    osm_id_from_ordinal(ordinal),
+                    &mut output,
+                )
+                .map_err(|e| self.sources[here.0].locate_at(here.1, e))?;
+            if !output.filled.is_empty() {
+                let origin = output.origin.replace(here);
+                self.ship(&mut output, emitter, origin)?;
+            } else if output.origin.is_none() {
+                output.origin = Some(here);
+            }
+            elements += 1;
+            if elements == first_flush {
+                self.flush(&mut output, emitter)?;
+            }
+            if elements.is_multiple_of(SWEEP_CHECKPOINT_REMOVALS as u64) {
+                self.cancel.check()?;
+                if emitter.abandoned() {
+                    return Err(Error::internal("sort range abandoned"));
+                }
+            }
+            self.offer(&mut heap, slot, slice);
+        }
+        if elements != work.count {
+            return Err(Error::internal(
+                "sort range emitted an inexact record count",
+            ));
+        }
+        self.flush(&mut output, emitter)?;
+        output.send(emitter)?;
+        Ok(RunCounts {
+            elements,
+            chunks: output.chunks,
+            chunk_high_water: output.chunk_high_water,
+            staged_high_water: output.staged_high_water,
+            ..RunCounts::default()
+        })
+    }
+
+    fn offer(&self, heap: &mut Heap, slot: usize, slice: &Slice<'_>) {
+        if let Some(first) = slice.keys.first() {
+            let key = Key::decode(first);
+            let frame = &self.frames[slice.run.frame];
+            // Each source frame yields one sorted feed; its equal keys
+            // already follow occurrence order in the original frame.
+            heap.push(Reverse((
+                key.ordinal,
+                key.version,
+                frame.source,
+                frame.file_offset,
+                slot,
+            )));
+        }
+    }
+
+    fn flush(&self, out: &mut Output<'_>, emitter: &Emitter<'_, Chunk, RunCounts>) -> Result<()> {
+        crate::commands::flush_local(&mut out.bb, &mut out.filled)?;
+        let origin = out.origin.take();
+        self.ship(out, emitter, origin)
+    }
+
+    fn ship(
+        &self,
+        out: &mut Output<'_>,
+        emitter: &Emitter<'_, Chunk, RunCounts>,
+        origin: Option<(usize, u64)>,
+    ) -> Result<()> {
+        out.ship(emitter, &|e| match origin {
+            Some((source, offset)) => self.sources[source].locate_at(offset, e),
+            None => e,
+        })
+    }
+}
+
+type Heap = BinaryHeap<Reverse<(u64, i32, usize, u64, usize)>>;
+
+struct RangeOutput<'a, 'w> {
+    out: &'a mut PlanWriter<'w>,
+    counts: RunCounts,
+    ranges: usize,
+}
+
+impl StreamConsumer<Chunk, RunCounts> for RangeOutput<'_, '_> {
+    fn item(&mut self, _task: usize, chunk: Chunk) -> Result<()> {
+        self.out.writer.write_raw_chunks(chunk)
+    }
+
+    fn finish_task(&mut self, _task: usize, counts: RunCounts) -> Result<()> {
+        self.counts.elements += counts.elements;
+        self.counts.chunks += counts.chunks;
+        self.counts.chunk_high_water = self.counts.chunk_high_water.max(counts.chunk_high_water);
+        self.counts.staged_high_water = self.counts.staged_high_water.max(counts.staged_high_water);
+        self.ranges += 1;
+        Ok(())
+    }
+}
+
+pub(in crate::commands::blob_merge) fn write(
+    out: &mut PlanWriter<'_>,
+    run: &Run,
+    config: Config<'_>,
+    compression: &Compression,
+    metrics: &WriterMetrics,
+    workers: usize,
+    host: &Entered<'_>,
+) -> Result<Option<RunCounts>> {
+    let scratch = RunScratch::create(config.parent, host)?;
+    let path = scratch.file("sort-ranges")?;
+    let file = crate::scratch::create_read_write(&path, true)
+        .map_err(|e| Error::from(e).context(format!("create {}", path.display())))?;
+    let mut spill = Spill {
+        file: BufWriter::with_capacity(crate::write::IO_BUF_BYTES, file),
+        runs: Vec::new(),
+        size: 0,
+        needs_legacy: false,
+    };
+    host.invocation.marker("SORT_RANGE_PREPARE_START");
+    prepare_runs(
+        out.plan,
+        out.sources,
+        run,
+        workers,
+        &host.invocation,
+        &mut spill,
+    )
+    .map_err(|e| e.context(format!("prepare sort ranges in {}", path.display())))?;
+    host.invocation.marker("SORT_RANGE_PREPARE_END");
+    if spill.needs_legacy || spill.runs.is_empty() {
+        host.invocation.counter("sort_range_legacy_fallback", 1);
+        return Ok(None);
+    }
+    let file = spill
+        .file
+        .into_inner()
+        .map_err(std::io::IntoInnerError::into_error)?;
+    // SAFETY: the spill is in this invocation's private scratch directory.
+    // Its writer is flushed above and nothing modifies it after this point.
+    let mapped = unsafe { memmap2::Mmap::map(file.as_file()) }
+        .map_err(|e| Error::from(e).context(format!("map {}", path.display())))?;
+    host.invocation
+        .counter("sort_range_spill_bytes", spill.size);
+    let first = Work::new(
+        spill
+            .runs
+            .iter()
+            .map(|run| Slice {
+                run,
+                keys: run.keys(&mapped),
+                body_end: run.bodies.len(),
+            })
+            .collect(),
+    );
+    let mut schedule = Schedule {
+        pending: vec![first],
+        target: config.target_records,
+        ordinal: 0,
+    };
+    let plan = out.plan;
+    let merge = MergeRanges {
+        mapped: &mapped,
+        frames: &plan.frames,
+        sources: out.sources,
+        kind: run.kind,
+        keep_locations: plan.keep_locations,
+        compression,
+        metrics,
+        cancel: &host.invocation,
+    };
+    let mut drain = RangeOutput {
+        out,
+        counts: RunCounts::default(),
+        ranges: 0,
+    };
+    host.invocation.marker("SORT_RANGE_MERGE_START");
+    ordered_pool::run_ordered_streams_from(
+        &mut || schedule.next(&host.invocation),
+        workers,
+        StreamConfig {
+            window: super::super::run_window(workers),
+            depth: OVERLAP_RUN_CHANNEL_DEPTH,
+            cancel: &host.invocation,
+        },
+        |_| (),
+        |&mut (), _, work, emitter| merge.merge(work, emitter),
+        &mut drain,
+    )?;
+    host.invocation.marker("SORT_RANGE_MERGE_END");
+    host.invocation.counter("sort_ranges", drain.ranges);
+    Ok(Some(drain.counts))
+}
+
+fn prepare_runs(
+    plan: &Plan,
+    sources: &Sources,
+    run: &Run,
+    workers: usize,
+    cancel: &Recorder,
+    spill: &mut Spill,
+) -> Result<()> {
+    let mut shards = vec![(); workers.min(run.end - run.start)];
+    let mut validation_failed = false;
+    let result = ordered_pool::run_ordered(
+        run.end - run.start,
+        &mut shards,
+        PoolConfig {
+            window: NonZeroUsize::new(workers).unwrap_or(NonZeroUsize::MIN),
+            cancel,
+            waits: ordered_pool::Waits::default(),
+        },
+        |_| FrameBuf::default(),
+        |&mut (), buf, k| Ok(prepare(plan, sources, run, run.start + k, buf, cancel)),
+        &mut ConsumeFn(|_, prepared: Result<Prepared>| match prepared {
+            Ok(prepared) => spill.push(&prepared),
+            Err(error) => {
+                validation_failed = !matches!(
+                    error.kind(),
+                    crate::ErrorKind::Io(_)
+                        | crate::ErrorKind::InputReplaced
+                        | crate::ErrorKind::Cancelled
+                        | crate::ErrorKind::Internal { .. }
+                );
+                Err(error)
+            }
+        }),
+    );
+    // Preparation visits frames and fields in a different order from the
+    // sweep. When input validation fails, the sweep decides which failure
+    // to return in its original order. Scratch write failures stay here.
+    if validation_failed {
+        spill.needs_legacy = true;
+        cancel.check()
+    } else {
+        result
+    }
+}
