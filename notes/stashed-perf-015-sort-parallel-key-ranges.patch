+/// A believed sorted claim does not excuse a descent in an overlap run.
+/// Exercise both production routes. Dropping a staged writer is valid
+/// refusal cleanup; the unit-test drop assertion would mask the error.
+#[test]
+fn a_believed_blob_internally_out_of_order_is_still_refused() {
+    use pbfhogg::block_builder::{BlockBuilder, DEFAULT_ELEMENT_CAP, HeaderBuilder};
+    use pbfhogg::writer::{Compression, PbfWriter};
+
+    // 128 full blobs share one range and exceed the one-million-record
+    // threshold. Build the repeated payload once to keep the fixture cheap.
+    for (overlapping_blobs, expected_fallbacks) in [(1, 0), (128, 1)] {
+        let dir = crate::common::test_scratch();
+        let input = dir.path().join("false-order.pbf");
+        let output = dir.path().join("failed.pbf");
+        let file = std::fs::File::create(&input).expect("create fixture");
+        let mut writer = PbfWriter::new(std::io::BufWriter::new(file), Compression::None);
+        writer
+            .write_header(&HeaderBuilder::new().sorted().build().expect("header"))
+            .expect("write header");
+        let mut builder = BlockBuilder::new();
+        for id in [3, 1] {
+            builder.add_node(id, 2, 3, [], None);
+        }
+        writer
+            .write_primitive_block(builder.take().expect("encode").expect("descending nodes"))
+            .expect("write descending nodes");
+        let cap = i64::try_from(DEFAULT_ELEMENT_CAP.get()).expect("small cap");
+        for id in 2..2 + cap {
+            builder.add_node(id, 2, 3, [], None);
+        }
+        let block = builder.take().expect("encode").expect("overlapping nodes");
+        for _ in 0..overlapping_blobs {
+            writer.write_primitive_block(block).expect("write nodes");
+        }
