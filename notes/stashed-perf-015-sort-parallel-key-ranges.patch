+//! Packed scratch bodies. Each frame stores its strings once and shares
+//! the dictionary with every range that merges records from that frame.
+//! Neither writing to scratch nor reading it constructs an owned element.
+
+use protohoggr::{Cursor, encode_varint, zigzag_encode_64};
+use rustc_hash::FxHashMap;
+
+use super::super::Output;
+use crate::block_builder::{DenseMetadata, MemberData, Metadata, PartialMetadata};
+use crate::owned::{declared_way_locations, dense_node_metadata, element_metadata};
+use crate::{DenseColumns, Element, ElementKind, Error, MemberId, MemberType, Result};
+
+#[derive(Default)]
+pub(super) struct Bodies {
+    pub(super) bytes: Vec<u8>,
+    pub(super) strings: Vec<u8>,
+    slots: FxHashMap<String, usize>,
+    locations: Vec<(i32, i32)>,
+}
+
+#[derive(Clone, Copy)]
+enum Meta<'a> {
+    Plain(Option<PartialMetadata<'a>>),
+    Dense(DenseMetadata<'a>),
+}
+
+impl<'a> Meta<'a> {
+    fn plain(self) -> Result<Option<PartialMetadata<'a>>> {
+        match self {
+            Self::Plain(meta) => Ok(meta),
+            Self::Dense(_) => Err(corrupt()),
+        }
+    }
+}
+
+impl Bodies {
+    fn number(&mut self, value: u64) {
+        encode_varint(&mut self.bytes, value);
+    }
+
+    fn signed(&mut self, value: i64) {
+        self.number(zigzag_encode_64(value));
+    }
+
+    fn string(&mut self, value: &str) {
+        let offset = if let Some(&slot) = self.slots.get(value) {
+            slot
+        } else {
+            let slot = self.strings.len();
+            encode_varint(&mut self.strings, value.len() as u64);
+            self.strings.extend_from_slice(value.as_bytes());
+            self.slots.insert(value.to_owned(), slot);
+            slot
+        };
+        self.number(offset as u64);
+    }
+
+    fn metadata(&mut self, metadata: Meta<'_>) {
+        let (mask, fields) = match metadata {
+            Meta::Plain(None) => {
+                self.number(0);
+                return;
+            }
+            Meta::Plain(Some(fields)) => (0, fields),
+            Meta::Dense(DenseMetadata { meta, columns, .. }) => (
+                1 << 6,
+                PartialMetadata {
+                    version: columns.version().then_some(meta.version),
+                    timestamp: columns.timestamp().then_some(meta.timestamp),
+                    changeset: columns.changeset().then_some(meta.changeset),
+                    uid: columns.uid().then_some(meta.uid),
+                    user: columns.user().then_some(meta.user),
+                    visible: columns.visible().then_some(meta.visible),
+                },
+            ),
+        };
+        let PartialMetadata {
+            version,
+            timestamp,
+            changeset,
+            uid,
+            user,
+            visible,
+        } = fields;
+        let present = [
+            version.is_some(),
+            timestamp.is_some(),
+            changeset.is_some(),
+            uid.is_some(),
+            user.is_some(),
+            visible.is_some(),
+        ];
+        self.number(
+            present
+                .into_iter()
+                .enumerate()
+                .fold(mask, |mask, (i, set)| mask | (u64::from(set) << i)),
+        );
+        for value in [
+            version.map(i64::from),
+            timestamp,
+            changeset,
+            uid.map(i64::from),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            self.signed(value);
+        }
+        if let Some(user) = user {
+            self.string(user);
+        }
+        if let Some(visible) = visible {
+            self.number(u64::from(visible));
+        }
+    }
+
+    fn slot(&mut self) -> usize {
+        let start = self.bytes.len();
+        self.bytes.extend_from_slice(&[0; 4]);
+        start
+    }
+
+    fn fill(&mut self, start: usize, value: usize) -> Result<()> {
+        let value = u32::try_from(value)
+            .map_err(|_| Error::internal("packed sort record exceeds 4 GiB"))?;
+        self.bytes[start..start + 4].copy_from_slice(&value.to_le_bytes());
+        Ok(())
+    }
+
+    fn coords(&mut self, lat: i32, lon: i32) {
+        self.signed(i64::from(lat));
+        self.signed(i64::from(lon));
+    }
+
+    fn tags<'t>(&mut self, tags: impl Iterator<Item = (&'t str, &'t str)>) {
+        for (key, value) in tags {
+            self.string(key);
+            self.string(value);
+        }
+    }
+
+    fn way(&mut self, way: &crate::Way<'_>, keep_locations: bool) -> Result<()> {
+        let meta = element_metadata(ElementKind::Way, way.id(), &way.info())?;
+        let slot = self.slot();
+        let mut prev = 0i64;
+        let mut count = 0;
+        for id in way.refs() {
+            self.signed(id.wrapping_sub(prev));
+            prev = id;
+            count += 1;
+        }
+        self.fill(slot, count)?;
+        if keep_locations {
+            declared_way_locations(way, count, &mut self.locations)?;
+            let locations = std::mem::take(&mut self.locations);
+            for &(lat, lon) in &locations {
+                self.coords(lat, lon);
+            }
+            self.locations = locations;
+        }
+        self.metadata(Meta::Plain(meta));
+        self.tags(way.tags());
+        Ok(())
+    }
+
+    fn relation(&mut self, relation: &crate::Relation<'_>) -> Result<()> {
+        let slot = self.slot();
+        let mut prev = 0i64;
+        let mut count = 0;
+        for (position, member) in relation.members().enumerate() {
+            let id = member.id.id();
+            self.signed(id.wrapping_sub(prev));
+            prev = id;
+            let kind = match member.id.member_type() {
+                MemberType::Node => 0,
+                MemberType::Way => 1,
+                MemberType::Relation => 2,
+                MemberType::Unknown(raw) => raw,
+            };
+            self.signed(i64::from(kind));
+            self.string(relation.member_role(position, &member)?);
+            count += 1;
+        }
+        self.fill(slot, count)?;
+        self.metadata(Meta::Plain(element_metadata(
+            ElementKind::Relation,
+            relation.id(),
+            &relation.info(),
+        )?));
+        self.tags(relation.tags());
+        Ok(())
+    }
+
+    /// Returns true when the serial sweep can change this node's sort
+    /// version at demotion. Its component must run through that sweep.
+    pub(super) fn push(&mut self, element: &Element<'_>, keep_locations: bool) -> Result<bool> {
+        let mut needs_legacy = false;
+        match element {
+            Element::DenseNode(node) => {
+                let dense = dense_node_metadata(node)?;
+                let meta = match &dense {
+                    Some(m) if m.writes_plain() => {
+                        needs_legacy = m.meta.version != 0;
+                        Meta::Plain(Some(m.plain_claim_metadata()))
+                    }
+                    Some(m) => Meta::Dense(*m),
+                    None => Meta::Plain(None),
+                };
+                self.coords(node.decimicro_lat()?, node.decimicro_lon()?);
+                self.metadata(meta);
+                self.tags(node.tags());
+            }
+            Element::Node(node) => {
+                let meta = element_metadata(ElementKind::Node, node.id(), &node.info())?;
+                self.coords(node.decimicro_lat()?, node.decimicro_lon()?);
+                self.metadata(Meta::Plain(meta));
+                self.tags(node.tags());
+            }
+            Element::Way(way) => self.way(way, keep_locations)?,
+            Element::Relation(relation) => self.relation(relation)?,
+        }
+        Ok(needs_legacy)
+    }
+}
+
+struct Body<'a> {
+    cursor: Cursor<'a>,
+    strings: &'a [u8],
+}
+
+fn corrupt() -> Error {
+    Error::internal("invalid packed sort run record")
+}
+
+impl<'a> Body<'a> {
+    fn number(&mut self) -> Result<usize> {
+        let value = self.cursor.read_varint().map_err(|_| corrupt())?;
+        usize::try_from(value).map_err(|_| corrupt())
+    }
+
+    fn count(&mut self) -> Result<usize> {
+        self.cursor
+            .read_fixed32()
+            .map(|n| n as usize)
+            .map_err(|_| corrupt())
+    }
+
+    fn signed(&mut self) -> Result<i64> {
+        self.cursor.read_sint64().map_err(|_| corrupt())
+    }
+
+    fn int(&mut self) -> Result<i32> {
+        i32::try_from(self.signed()?).map_err(|_| corrupt())
+    }
+
+    fn string(&mut self) -> Result<&'a str> {
+        let start = self.number()?;
+        let mut cursor = Cursor::new(self.strings.get(start..).ok_or_else(corrupt)?);
+        let bytes = cursor.read_len_delimited().map_err(|_| corrupt())?;
+        std::str::from_utf8(bytes).map_err(|_| corrupt())
+    }
+
+    fn metadata(&mut self) -> Result<Meta<'a>> {
+        let mask = self.number()?;
+        if mask == 0 {
+            return Ok(Meta::Plain(None));
+        }
+        let present = [0, 1, 2, 3, 4, 5].map(|i| mask & (1 << i) != 0);
+        let [version, timestamp, changeset, uid, user, visible] = present;
+        let version = version.then(|| self.int()).transpose()?;
+        let timestamp = timestamp.then(|| self.signed()).transpose()?;
+        let changeset = changeset.then(|| self.signed()).transpose()?;
+        let uid = uid.then(|| self.int()).transpose()?;
+        let user = user.then(|| self.string()).transpose()?;
+        let visible = visible.then(|| self.number().map(|n| n != 0)).transpose()?;
+        Ok(if mask & (1 << 6) == 0 {
+            Meta::Plain(Some(PartialMetadata {
+                version,
+                timestamp,
+                changeset,
+                uid,
+                user,
+                visible,
+            }))
+        } else {
+            Meta::Dense(DenseMetadata {
+                meta: Metadata {
+                    version: version.unwrap_or_default(),
+                    timestamp: timestamp.unwrap_or_default(),
+                    changeset: changeset.unwrap_or_default(),
+                    uid: uid.unwrap_or_default(),
+                    user: user.unwrap_or_default(),
+                    visible: visible.unwrap_or(true),
+                },
+                columns: DenseColumns::from_presence(present),
+                explicit: DenseColumns::default(),
+            })
+        })
+    }
+
+    fn tags(&mut self, tags: &mut Vec<(&'a str, &'a str)>) -> Result<()> {
+        tags.clear();
+        while !self.cursor.is_empty() {
+            tags.push((self.string()?, self.string()?));
+        }
+        Ok(())
+    }
+
+    fn refs(&mut self, refs: &mut Vec<i64>) -> Result<()> {
+        refs.clear();
+        let mut prev = 0i64;
+        for _ in 0..self.count()? {
+            prev = prev.wrapping_add(self.signed()?);
+            refs.push(prev);
+        }
+        Ok(())
+    }
+
+    fn members(&mut self, members: &mut Vec<MemberData<'a>>) -> Result<()> {
+        members.clear();
+        let mut prev = 0i64;
+        for _ in 0..self.count()? {
+            prev = prev.wrapping_add(self.signed()?);
+            let id = match self.int()? {
+                0 => MemberId::Node(prev),
+                1 => MemberId::Way(prev),
+                2 => MemberId::Relation(prev),
+                raw => MemberId::Unknown(raw, prev),
+            };
+            members.push(MemberData {
+                id,
+                role: self.string()?,
+            });
+        }
+        Ok(())
+    }
+}
+
+#[derive(Default)]
+pub(super) struct EncodeScratch<'a> {
+    tags: Vec<(&'a str, &'a str)>,
+    refs: Vec<i64>,
+    locations: Vec<(i32, i32)>,
+    members: Vec<MemberData<'a>>,
+}
+
+impl<'a> EncodeScratch<'a> {
+    pub(super) fn write(
+        &mut self,
+        bytes: &'a [u8],
+        strings: &'a [u8],
+        kind: ElementKind,
+        id: i64,
+        out: &mut Output<'_>,
+    ) -> Result<()> {
+        let mut body = Body {
+            cursor: Cursor::new(bytes),
+            strings,
+        };
+        match kind {
+            ElementKind::Node => self.node(&mut body, id, out),
+            ElementKind::Way => self.way(&mut body, id, out),
+            ElementKind::Relation => self.relation(&mut body, id, out),
+        }
+    }
+
+    fn node(&mut self, body: &mut Body<'a>, id: i64, out: &mut Output<'_>) -> Result<()> {
+        let lat = body.int()?;
+        let lon = body.int()?;
+        let meta = body.metadata()?;
+        body.tags(&mut self.tags)?;
+        crate::commands::ensure_node_capacity_local(&mut out.bb, &mut out.filled)?;
+        let tags = self.tags.iter().copied();
+        match meta {
+            Meta::Plain(meta) => out.bb.add_node_partial(id, lat, lon, tags, meta.as_ref()),
+            Meta::Dense(meta) => out.bb.add_node_dense(id, lat, lon, tags, Some(&meta)),
+        }
+        Ok(())
+    }
+
+    fn way(&mut self, body: &mut Body<'a>, id: i64, out: &mut Output<'_>) -> Result<()> {
+        body.refs(&mut self.refs)?;
+        self.locations.clear();
+        let keep = out.coords == crate::owned::WayCoords::Keep;
+        if keep {
+            for _ in 0..self.refs.len() {
+                self.locations.push((body.int()?, body.int()?));
+            }
+        }
+        let meta = body.metadata()?.plain()?;
+        body.tags(&mut self.tags)?;
+        crate::commands::ensure_way_capacity_local(&mut out.bb, &mut out.filled)?;
+        let tags = self.tags.iter().copied();
+        if keep {
+            out.bb.add_way_with_locations_partial(
+                id,
+                tags,
+                &self.refs,
+                &self.locations,
+                meta.as_ref(),
+            );
+        } else {
+            out.bb.add_way_partial(id, tags, &self.refs, meta.as_ref());
+        }
+        Ok(())
+    }
+
+    fn relation(&mut self, body: &mut Body<'a>, id: i64, out: &mut Output<'_>) -> Result<()> {
+        body.members(&mut self.members)?;
+        let meta = body.metadata()?.plain()?;
+        body.tags(&mut self.tags)?;
+        crate::commands::ensure_relation_capacity_local(&mut out.bb, &mut out.filled)?;
+        out.bb.add_relation_partial_iter(
+            id,
+            self.tags.iter().copied(),
+            self.members.iter().copied().map(Ok),
+            meta.as_ref(),
+        )
+    }
+}
