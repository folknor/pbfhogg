+                assert!((2..usize::try_from(BLOBS).unwrap()).contains(&wide.len()));
+                assert!(wide.iter().all(|(count, _)| {
+                    *count <= crate::block_builder::DEFAULT_ELEMENT_CAP.get() as u64
+                }));
+            }
+            for (i, (region, path)) in regions.iter().zip(&paths).enumerate() {
+                let reference = scratch.child(format!("serial-{strategy:?}-{i}.pbf"));
+                let output = Output::new(&reference, Overwrite::Refuse, &host.diagnostics).unwrap();
+                let reference_stats = extract(
+                    input.as_path(),
+                    output,
+                    region,
+                    strategy,
+                    true,
+                    clean,
+                    &options,
+                    &overrides,
+                    &host,
+                )
+                .unwrap();
+                let mut summary = Vec::new();
+                let mut reference_summary = Vec::new();
+                stats[i].write_summary(&mut summary).unwrap();
+                reference_stats
+                    .write_summary(&mut reference_summary)
+                    .unwrap();
+                assert_eq!(summary, reference_summary);
+                let actual = digest(path.as_path(), Form::Full, false, &host).unwrap();
+                let expected = digest(reference.as_path(), Form::Full, false, &host).unwrap();
+                assert_eq!(actual, expected, "{strategy:?} region {i}");
+                if i == 1 || i == 2 {
+                    assert_eq!(
+                        std::fs::read(path).unwrap(),
+                        std::fs::read(reference).unwrap()
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn indexed_multi_extract_keeps_contents_across_packed_blobs() {
+        parity(true, &CleanAttrs::default());
+    }
+
+    #[test]
+    fn unindexed_multi_extract_keeps_cleaned_contents_across_packed_blobs() {
+        parity(
+            false,
+            &CleanAttrs {
+                version: true,
+                ..CleanAttrs::default()
+            },
+        );
+    }
+}
