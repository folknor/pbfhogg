diff --git a/crates/lib/src/commands/extract/multi_output.rs b/crates/lib/src/commands/extract/multi_output.rs
new file mode 100644
index 00000000..61e3c34f
--- /dev/null
+++ b/crates/lib/src/commands/extract/multi_output.rs
@@ -0,0 +1,748 @@
+//! Ordered multi-extract output. A ready entry represents one destination's
+//! head job. The worker owns that writer until the job ends, then puts the
+//! destination at the back of the ready list if it has more work.
+//!
+//! The producer admits jobs in input order for each destination. Framing of
+//! full blocks stays on the decode workers. Small terminal blocks can be
+//! grouped across input blobs, then packed and framed on the output workers.
+//! Raw frames fence a pack only for the destinations that receive them.
+
+use std::collections::VecDeque;
+use std::io::Write;
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, PoisonError};
+
+use crate::block_builder::{BlockBuilder, DEFAULT_ELEMENT_CAP, OwnedBlock};
+use crate::error::{Error, Result};
+use crate::host::Recorder;
+use crate::owned::{WayCoords, WayScratch, dense_node_metadata, element_metadata};
+use crate::tunables::{
+    EXTRACT_MULTI_OUTPUT_BYTES, EXTRACT_MULTI_OUTPUT_WORKERS, EXTRACT_MULTI_PACK_BYTES,
+};
+use crate::writer::PbfWriter;
+use crate::{Element, ElementKind, PrimitiveBlock};
+
+use super::RegionFraming;
+
+pub(in crate::commands::extract) struct RegionBatch {
+    pub(super) frames: Vec<Vec<u8>>,
+    pub(super) tail: Option<OwnedBlock>,
+}
+
+pub(in crate::commands::extract) type RegionOutput<'a> =
+    Producer<'a, std::io::BufWriter<std::fs::File>>;
+
+pub(in crate::commands::extract) fn run<T>(
+    writers: Vec<PbfWriter<std::io::BufWriter<std::fs::File>>>,
+    framing: &RegionFraming<'_>,
+    coords: WayCoords,
+    cancel: &Recorder,
+    produce: impl FnOnce(&mut RegionOutput<'_>) -> Result<T>,
+) -> Result<T> {
+    run_with(
+        writers,
+        cancel,
+        EXTRACT_MULTI_OUTPUT_BYTES,
+        produce,
+        |writer, region, action, scratch| match action {
+            Action::Frame(frame) => writer.write_raw_owned(frame),
+            Action::Raw(frame) => writer.write_raw(&frame),
+            Action::Pack(pack) => {
+                let block = pack
+                    .build(coords, scratch)
+                    .map_err(|e| e.writing(framing.destinations[region]))?;
+                for frame in framing.frame_region(region, std::iter::once(block))? {
+                    writer.write_raw_owned(frame)?;
+                }
+                Ok(())
+            }
+            Action::Flush => writer.flush().map_err(|e| {
+                e.context(format!(
+                    "failed to flush {}",
+                    framing.destinations[region].display()
+                ))
+            }),
+        },
+    )
+}
+
+fn run_with<T, W: Write + Send>(
+    writers: Vec<PbfWriter<W>>,
+    cancel: &Recorder,
+    budget: usize,
+    produce: impl FnOnce(&mut Producer<'_, W>) -> Result<T>,
+    execute: impl Fn(&mut PbfWriter<W>, usize, Action, &mut PackScratch) -> Result<()> + Sync,
+) -> Result<T> {
+    let regions = writers.len();
+    let owned_scheduler = Scheduler::new(writers, budget);
+    let execute = &execute;
+    let scheduler = &owned_scheduler;
+    let result = crate::threads::scope(cancel, |scope| {
+        // On every early return, including a refused spawn or unwind, wake
+        // workers before the scope joins them.
+        let stop = StopOnDrop(scheduler);
+        for _ in 0..regions.min(EXTRACT_MULTI_OUTPUT_WORKERS) {
+            scope.spawn(|| {
+                let _stop_on_exit = StopOnDrop(scheduler);
+                let mut scratch = PackScratch::default();
+                while let Some((region, mut writer, job)) = scheduler.take() {
+                    let result = cancel
+                        .check()
+                        .and_then(|()| execute(&mut writer, region, job.action, &mut scratch));
+                    scheduler.complete(region, writer, job.bytes, result);
+                }
+            })?;
+        }
+        let mut output = Producer {
+            scheduler,
+            pending: (0..regions).map(|_| Pack::default()).collect(),
+            budget_wait: std::time::Duration::ZERO,
+        };
+        let value = produce(&mut output)?;
+        output.finish()?;
+        let peak = scheduler.lock().peak;
+        let wait_ns = u64::try_from(output.budget_wait.as_nanos()).unwrap_or(u64::MAX);
+        cancel.counter("multi_extract_output_peak_payload_bytes", peak);
+        cancel.counter("multi_extract_output_budget_wait_ns", wait_ns);
+        drop(stop);
+        cancel.check()?;
+        Ok(value)
+    });
+    if result.is_err() {
+        owned_scheduler.abandon();
+    }
+    result
+}
+
+enum Action {
+    Frame(Vec<u8>),
+    Raw(Arc<Vec<u8>>),
+    Pack(Pack),
+    Flush,
+}
+
+struct Job {
+    bytes: usize,
+    action: Action,
+}
+
+struct Destination<W: Write> {
+    writer: Option<PbfWriter<W>>,
+    queue: VecDeque<Job>,
+}
+
+struct State<W: Write> {
+    destinations: Vec<Destination<W>>,
+    ready: VecDeque<usize>,
+    bytes: usize,
+    peak: usize,
+    jobs: usize,
+    stopped: bool,
+    error: Option<Error>,
+}
+
+struct Scheduler<W: Write> {
+    state: Mutex<State<W>>,
+    changed: Condvar,
+    budget: usize,
+}
+
+impl<W: Write> Scheduler<W> {
+    fn new(writers: Vec<PbfWriter<W>>, budget: usize) -> Self {
+        Self {
+            state: Mutex::new(State {
+                destinations: writers
+                    .into_iter()
+                    .map(|writer| Destination {
+                        writer: Some(writer),
+                        queue: VecDeque::new(),
+                    })
+                    .collect(),
+                ready: VecDeque::new(),
+                bytes: 0,
+                peak: 0,
+                jobs: 0,
+                stopped: false,
+                error: None,
+            }),
+            changed: Condvar::new(),
+            budget,
+        }
+    }
+
+    fn lock(&self) -> MutexGuard<'_, State<W>> {
+        self.state.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn wait<'a>(&self, state: MutexGuard<'a, State<W>>) -> MutexGuard<'a, State<W>> {
+        self.changed
+            .wait(state)
+            .unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn check(state: &State<W>) -> Result<()> {
+        if let Some(error) = &state.error {
+            return Err(error.clone());
+        }
+        if state.stopped {
+            return Err(Error::internal("multi-extract: output scheduler stopped"));
+        }
+        Ok(())
+    }
+
+    fn fits(&self, used: usize, bytes: usize) -> bool {
+        used == 0 || bytes <= self.budget.saturating_sub(used)
+    }
+
+    fn reserve(&self, bytes: usize) -> Result<bool> {
+        let mut state = self.lock();
+        Self::check(&state)?;
+        if !self.fits(state.bytes, bytes) {
+            return Ok(false);
+        }
+        state.bytes += bytes;
+        state.peak = state.peak.max(state.bytes);
+        Ok(true)
+    }
+
+    fn wait_for_space(&self, bytes: usize) -> Result<()> {
+        let mut state = self.lock();
+        loop {
+            Self::check(&state)?;
+            if self.fits(state.bytes, bytes) {
+                return Ok(());
+            }
+            state = self.wait(state);
+        }
+    }
+
+    /// The producer has already charged the job, including any time it spent
+    /// in a pending pack. Enqueuing never waits on a destination.
+    fn submit(&self, region: usize, job: Job) -> Result<()> {
+        let mut state = self.lock();
+        Self::check(&state)?;
+        let destination = &mut state.destinations[region];
+        let ready = destination.writer.is_some() && destination.queue.is_empty();
+        destination.queue.push_back(job);
+        state.jobs += 1;
+        if ready {
+            state.ready.push_back(region);
+            self.changed.notify_all();
+        }
+        Ok(())
+    }
+
+    fn take(&self) -> Option<(usize, PbfWriter<W>, Job)> {
+        let mut state = self.lock();
+        while !state.stopped {
+            if let Some(region) = state.ready.pop_front() {
+                let destination = &mut state.destinations[region];
+                if let (Some(writer), Some(job)) =
+                    (destination.writer.take(), destination.queue.pop_front())
+                {
+                    return Some((region, writer, job));
+                }
+                state.error = Some(Error::internal("multi-extract: invalid ready destination"));
+                state.stopped = true;
+                self.changed.notify_all();
+                return None;
+            }
+            state = self.wait(state);
+        }
+        None
+    }
+
+    fn complete(&self, region: usize, writer: PbfWriter<W>, bytes: usize, result: Result<()>) {
+        let mut state = self.lock();
+        assert!(
+            state.bytes >= bytes && state.jobs != 0,
+            "multi-extract: uncharged output job"
+        );
+        let destination = &mut state.destinations[region];
+        assert!(
+            destination.writer.is_none(),
+            "multi-extract: destination already has its writer"
+        );
+        destination.writer = Some(writer);
+        let more = !destination.queue.is_empty();
+        state.bytes -= bytes;
+        state.jobs -= 1;
+        match result {
+            Err(error) if !state.stopped => {
+                state.error = Some(error);
+                state.stopped = true;
+            }
+            Ok(()) if more && !state.stopped => state.ready.push_back(region),
+            _ => {}
+        }
+        self.changed.notify_all();
+    }
+
+    fn drain(&self) -> Result<()> {
+        let mut state = self.lock();
+        loop {
+            Self::check(&state)?;
+            if state.jobs == 0 {
+                return Ok(());
+            }
+            state = self.wait(state);
+        }
+    }
+
+    fn stop(&self) {
+        self.lock().stopped = true;
+        self.changed.notify_all();
+    }
+
+    fn abandon(self) {
+        let state = self
+            .state
+            .into_inner()
+            .unwrap_or_else(PoisonError::into_inner);
+        for destination in state.destinations {
+            if let Some(writer) = destination.writer {
+                // End the staged writer's session without certifying its
+                // partial output. The error that stopped the run wins.
+                let _abandoned = writer.into_inner();
+            }
+        }
+    }
+}
+
+struct StopOnDrop<'a, W: Write>(&'a Scheduler<W>);
+
+impl<W: Write> Drop for StopOnDrop<'_, W> {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
+
+pub(in crate::commands::extract) struct Producer<'a, W: Write> {
+    scheduler: &'a Scheduler<W>,
+    pending: Vec<Pack>,
+    budget_wait: std::time::Duration,
+}
+
+struct ReadyBatch {
+    region: usize,
+    raw: Option<Arc<Vec<u8>>>,
+    frames: std::vec::IntoIter<Vec<u8>>,
+    tail: Option<OwnedBlock>,
+}
+
+impl ReadyBatch {
+    fn has_work(&self) -> bool {
+        self.raw.is_some() || !self.frames.as_slice().is_empty() || self.tail.is_some()
+    }
+}
+
+impl<W: Write> Producer<'_, W> {
+    pub(in crate::commands::extract) fn write_blob(
+        &mut self,
+        batches: Option<Vec<RegionBatch>>,
+        raw: Option<(Vec<u8>, &[u64])>,
+    ) -> Result<()> {
+        if batches
+            .as_ref()
+            .is_some_and(|b| b.len() != self.pending.len())
+        {
+            return Err(Error::internal(
+                "multi-extract: wrong number of destination batches",
+            ));
+        }
+        let raw = raw.map(|(frame, mask)| (Arc::new(frame), mask));
+        let mut batches = batches.into_iter().flatten();
+        // A large fan-out can fill the shared budget. Offer each destination
+        // a frame before offering the same destination its next frame, raw
+        // or rebuilt. A head too big for the remaining credit waits its turn
+        // while smaller heads can still be admitted.
+        let mut ready: VecDeque<_> = (0..self.pending.len())
+            .map(|region| {
+                let (frames, tail) = batches
+                    .next()
+                    .map_or_else(|| (Vec::new(), None), |batch| (batch.frames, batch.tail));
+                let raw = raw.as_ref().and_then(|(frame, mask)| {
+                    super::super::membership::admits(Some(mask), region).then(|| Arc::clone(frame))
+                });
+                ReadyBatch {
+                    region,
+                    raw,
+                    frames: frames.into_iter(),
+                    tail,
+                }
+            })
+            .filter(ReadyBatch::has_work)
+            .collect();
+        while !ready.is_empty() {
+            let mut next_credit = usize::MAX;
+            let mut advanced = false;
+            for _ in 0..ready.len() {
+                let Some(mut batch) = ready.pop_front() else {
+                    return Err(Error::internal("multi-extract: missing ready batch"));
+                };
+                match self.advance(&mut batch)? {
+                    Some(bytes) => next_credit = next_credit.min(bytes),
+                    None => advanced = true,
+                }
+                if batch.has_work() {
+                    ready.push_back(batch);
+                }
+            }
+            if !advanced && !ready.is_empty() {
+                self.wait_for_credit(next_credit)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Submit one head if there is credit, or leave it in place and report
+    /// how much credit would let it advance.
+    fn advance(&mut self, batch: &mut ReadyBatch) -> Result<Option<usize>> {
+        let region = batch.region;
+        let frame = batch
+            .raw
+            .as_deref()
+            .or_else(|| batch.frames.as_slice().first());
+        let bytes = if let Some(frame) = frame {
+            self.flush_pack(region)?;
+            frame.capacity()
+        } else if let Some(block) = &batch.tail {
+            if !self.pending[region].fits(block) {
+                self.flush_pack(region)?;
+            }
+            pack_bytes(block)
+        } else {
+            return Err(Error::internal("multi-extract: empty ready batch"));
+        };
+        if !self.scheduler.reserve(bytes)? {
+            return Ok(Some(bytes));
+        }
+        if let Some(frame) = batch.raw.take() {
+            self.scheduler.submit(
+                region,
+                Job {
+                    bytes,
+                    action: Action::Raw(frame),
+                },
+            )?;
+        } else if let Some(frame) = batch.frames.next() {
+            self.scheduler.submit(
+                region,
+                Job {
+                    bytes,
+                    action: Action::Frame(frame),
+                },
+            )?;
+        } else if let Some(block) = batch.tail.take() {
+            self.stage(region, block, bytes)?;
+        }
+        Ok(None)
+    }
+
+    fn wait_for_credit(&mut self, bytes: usize) -> Result<()> {
+        // A pending pack already owns its credit. Give those jobs to the
+        // workers, so no inactive pack can prevent an eligible head from
+        // being admitted (including an oversized job that needs an empty
+        // budget). Then wait on global credit, independent of any writer.
+        for region in 0..self.pending.len() {
+            self.flush_pack(region)?;
+        }
+        let start = std::time::Instant::now();
+        let result = self.scheduler.wait_for_space(bytes);
+        self.budget_wait += start.elapsed();
+        result
+    }
+
+    fn stage(&mut self, region: usize, block: OwnedBlock, bytes: usize) -> Result<()> {
+        let pack = &mut self.pending[region];
+        pack.bytes += bytes;
+        pack.payload += block.bytes.len();
+        pack.count += block.index.count;
+        pack.blocks.push(block);
+        if pack.count == DEFAULT_ELEMENT_CAP.get() as u64 {
+            self.flush_pack(region)?;
+        }
+        Ok(())
+    }
+
+    fn flush_pack(&mut self, region: usize) -> Result<()> {
+        let pack = std::mem::take(&mut self.pending[region]);
+        if pack.blocks.is_empty() {
+            return Ok(());
+        }
+        self.scheduler.submit(
+            region,
+            Job {
+                bytes: pack.bytes,
+                action: Action::Pack(pack),
+            },
+        )
+    }
+
+    fn finish(&mut self) -> Result<()> {
+        self.end_kind()?;
+        for region in 0..self.pending.len() {
+            self.scheduler.submit(
+                region,
+                Job {
+                    bytes: 0,
+                    action: Action::Flush,
+                },
+            )?;
+        }
+        self.scheduler.drain()
+    }
+
+    pub(in crate::commands::extract) fn end_kind(&mut self) -> Result<()> {
+        for region in 0..self.pending.len() {
+            self.flush_pack(region)?;
+        }
+        Ok(())
+    }
+}
+
+fn pack_bytes(block: &OwnedBlock) -> usize {
+    std::mem::size_of::<OwnedBlock>()
+        + block.bytes.capacity()
+        + block.tagdata.as_ref().map_or(0, Vec::capacity)
+        + block.way_members.as_ref().map_or(0, Vec::capacity)
+}
+
+#[derive(Default)]
+struct Pack {
+    blocks: Vec<OwnedBlock>,
+    bytes: usize,
+    payload: usize,
+    count: u64,
+}
+
+#[derive(Default)]
+struct PackScratch {
+    builder: Option<BlockBuilder>,
+    way: WayScratch,
+    strings: Vec<(u32, u32)>,
+    groups: Vec<(u32, u32)>,
+}
+
+impl Pack {
+    fn fits(&self, block: &OwnedBlock) -> bool {
+        self.blocks
+            .first()
+            .is_none_or(|first| first.index.kind == block.index.kind)
+            && self.count + block.index.count <= DEFAULT_ELEMENT_CAP.get() as u64
+            && self.payload + block.bytes.len() <= EXTRACT_MULTI_PACK_BYTES
+    }
+
+    /// A single fragment will frame exactly as it did at its input cut.
+    /// Multiple fragments have already been normalized by the original
+    /// emission walk (including cleaning and LocationsOnWays). Read that
+    /// canonical representation without cleaning it again, into one
+    /// builder, in order.
+    fn build(mut self, coords: WayCoords, scratch: &mut PackScratch) -> Result<OwnedBlock> {
+        if self.blocks.len() == 1 {
+            return self
+                .blocks
+                .pop()
+                .ok_or_else(|| Error::internal("multi-extract: empty pack"));
+        }
+        let builder = scratch.builder.get_or_insert_with(BlockBuilder::new);
+        for fragment in self.blocks {
+            let block = PrimitiveBlock::from_vec_with_scratch(
+                fragment.bytes,
+                &mut scratch.strings,
+                &mut scratch.groups,
+            )?;
+            append(&block, builder, &mut scratch.way, coords)?;
+        }
+        builder
+            .take_owned()?
+            .ok_or_else(|| Error::internal("multi-extract: empty pack"))
+    }
+}
+
+fn append(
+    block: &PrimitiveBlock,
+    builder: &mut BlockBuilder,
+    way: &mut WayScratch,
+    coords: WayCoords,
+) -> Result<()> {
+    let mut members = Vec::new();
+    for element in block.elements() {
+        match &element {
+            Element::DenseNode(node) => {
+                let (lat, lon) = super::super::common::dense_coords(node)?;
+                let meta = dense_node_metadata(node)?;
+                builder.add_node_dense(node.id(), lat, lon, node.tags(), meta.as_ref());
+            }
+            Element::Node(node) => {
+                let (lat, lon) = super::super::common::plain_coords(node)?;
+                let meta = element_metadata(ElementKind::Node, node.id(), &node.info())?;
+                builder.add_node_partial(node.id(), lat, lon, node.tags(), meta.as_ref());
+            }
+            Element::Way(element) => {
+                way.prepare(element, coords)?;
+                let meta = element_metadata(ElementKind::Way, element.id(), &element.info())?;
+                way.write(builder, element.tags(), meta.as_ref());
+            }
+            Element::Relation(relation) => {
+                relation.members_into(&mut members)?;
+                let meta =
+                    element_metadata(ElementKind::Relation, relation.id(), &relation.info())?;
+                builder.add_relation_partial(
+                    relation.id(),
+                    relation.tags(),
+                    &members,
+                    meta.as_ref(),
+                );
+            }
+        }
+    }
+    Ok(())
+}
