+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use std::io;
+    use std::sync::Barrier;
+
+    use crate::host::Host;
+    use crate::tunables::{TEST_HANG_BOUND, TEST_HANG_REPORT_GRACE};
+    use crate::writer::Compression;
+    use pbfhogg_test_scratch::HangBound;
+
+    use super::*;
+
+    #[test]
+    fn slow_writer_does_not_block_another_destinations_frontier() {
+        let _bound = HangBound::arm(TEST_HANG_BOUND, TEST_HANG_REPORT_GRACE, "output FIFO");
+        let owner = Host::for_tests();
+        let host = owner.entered();
+        let rendezvous = Barrier::new(2);
+        let writes = Mutex::new(Vec::new());
+        let writers: Vec<_> = (0..3)
+            .map(|_| PbfWriter::new(io::sink(), Compression::None))
+            .collect();
+        run_with(
+            writers,
+            &host.invocation,
+            3,
+            |output| {
+                output.write_blob(
+                    Some(
+                        [vec![vec![1, 0]], vec![], vec![]]
+                            .into_iter()
+                            .map(|frames| RegionBatch { frames, tail: None })
+                            .collect(),
+                    ),
+                    None,
+                )?;
+                output.write_blob(
+                    Some(
+                        [vec![vec![2, 0]], vec![vec![3], vec![4]], vec![]]
+                            .into_iter()
+                            .map(|frames| RegionBatch { frames, tail: None })
+                            .collect(),
+                    ),
+                    None,
+                )
+            },
+            |writer, region, action, _scratch| match action {
+                Action::Frame(frame) => {
+                    if frame[0] == 1 {
+                        rendezvous.wait();
+                        rendezvous.wait();
+                    } else if frame[0] == 3 {
+                        rendezvous.wait();
+                    }
+                    writes.lock().unwrap().push((region, frame[0]));
+                    if frame[0] == 3 {
+                        rendezvous.wait();
+                    }
+                    writer.write_raw_owned(frame)
+                }
+                Action::Flush => writer.flush(),
+                Action::Raw(_) | Action::Pack(_) => panic!("unexpected job"),
+            },
+        )
+        .unwrap();
+        let writes = writes.into_inner().unwrap();
+        assert_eq!(writes[0], (1, 3));
+        for (region, expected) in [(0, vec![1, 2]), (1, vec![3, 4]), (2, vec![])] {
+            let frames: Vec<_> = writes
+                .iter()
+                .filter(|(r, _)| *r == region)
+                .map(|&(_, f)| f)
+                .collect();
+            assert_eq!(frames, expected);
+        }
+    }
+
+    #[test]
+    fn write_credit_lasts_until_the_active_job_completes() {
+        let writers = vec![PbfWriter::new(io::sink(), Compression::None)];
+        let scheduler = Scheduler::new(writers, 8);
+        assert!(scheduler.reserve(8).unwrap());
+        scheduler
+            .submit(
+                0,
+                Job {
+                    bytes: 8,
+                    action: Action::Frame(vec![0; 8]),
+                },
+            )
+            .unwrap();
+        let (region, writer, Job { bytes, action }) = scheduler.take().unwrap();
+        assert!(!scheduler.reserve(1).unwrap());
+        drop(action);
+        scheduler.complete(region, writer, bytes, Ok(()));
+        assert!(
+            scheduler.reserve(9).unwrap(),
+            "one oversized job can advance"
+        );
+        assert!(!scheduler.reserve(1).unwrap());
+        assert_eq!(scheduler.lock().peak, 9);
+    }
+
+    #[test]
+    fn pending_packs_can_release_credit_without_changing_single_fragments() {
+        let _bound = HangBound::arm(TEST_HANG_BOUND, TEST_HANG_REPORT_GRACE, "pending output");
+        let owner = Host::for_tests();
+        let host = owner.entered();
+        let mut builder = BlockBuilder::new();
+        let blocks = [1, 2].map(|id| {
+            builder.add_node(id, 0, 0, [], None);
+            builder.take_owned().unwrap().unwrap()
+        });
+        let expected = blocks.each_ref().map(|block| block.bytes.clone());
+        let budget = blocks.iter().map(pack_bytes).max().unwrap();
+        let actual = Mutex::new(Vec::new());
+        run_with(
+            vec![PbfWriter::new(io::sink(), Compression::None)],
+            &host.invocation,
+            budget,
+            |output| {
+                for block in blocks {
+                    output.write_blob(
+                        Some(vec![RegionBatch {
+                            frames: Vec::new(),
+                            tail: Some(block),
+                        }]),
+                        None,
+                    )?;
+                }
+                Ok(())
+            },
+            |writer, _, action, scratch| match action {
+                Action::Pack(pack) => {
+                    let block = pack.build(WayCoords::Drop, scratch)?;
+                    actual.lock().unwrap().push(block.bytes);
+                    Ok(())
+                }
+                Action::Flush => writer.flush(),
+                Action::Frame(_) | Action::Raw(_) => panic!("unexpected frame"),
+            },
+        )
+        .unwrap();
+        assert_eq!(actual.into_inner().unwrap(), expected);
+    }
+}
