+    let lats = read_payload_field(&mut cursor, LAT_FIELD)?;
+    let lons = read_payload_field(&mut cursor, LON_FIELD)?;
+    // A zigzag-encoded difference between i32s occupies 1 to 5 bytes.
+    let valid_len = ref_count..=ref_count.saturating_mul(5);
+    for column in [lats, lons] {
+        if !valid_len.contains(&(column.len() as u64)) {
