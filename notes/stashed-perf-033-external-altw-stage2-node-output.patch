+                let mut writer = prefix.writer.unwrap();
+                append_way(&mut writer);
+                assert_eq!(
+                    std::fs::read(output_path).unwrap(),
+                    legacy_output(&header, &source, &metas, compression, keep_untagged),
+                );
+            }
