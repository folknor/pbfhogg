+    ) -> Result<()> {
+        use std::sync::atomic::Ordering::Relaxed;
+
+        let Some(output) = job.node_output else {
+            return Ok(());
+        };
+        for index in self.remaining.start..stop.min(self.remaining.end) {
+            job.host.invocation.check()?;
+            let meta = &output.metas[index];
+            let item = (|| {
+                if output.keep_untagged {
+                    counters.node_output_only_reads.fetch_add(1, Relaxed);
+                    let (frame, _) = read_frame(file, meta)?;
+                    return Ok(NodeResult::raw(frame, meta.count));
+                }
+                if !keep_node_blob(meta, output.members) {
+                    return Ok(NodeResult::skipped(meta.count));
+                }
+                counters.node_output_only_reads.fetch_add(1, Relaxed);
+                let body = read
+                    .read_exact_at(file, meta.data_offset, meta.data_size)
+                    .map_err(Error::from)?;
