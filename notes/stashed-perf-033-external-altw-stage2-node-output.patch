+        } else if keep_node_blob(meta, output.members) {
+            counters.node_output_shared_blobs.fetch_add(1, Relaxed);
+            self.rebuild(output, index, decoded, counters, &job.host.invocation)
+                .map_err(|e| job.input_pbf.locate_at(meta.frame_offset, e))
