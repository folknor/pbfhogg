+                        limits: &limits,
+                        ordered: &ordered,
+                    }),
+                    table_bytes: 2 * size_of::<u64>(),
+                    inject_prepass,
+                    host: &host,
+                };
+                assert_eq!(node_join(codec, &job).unwrap(), 2);
+                let prefix = ordered.finish(metas.len(), &host.invocation).unwrap();
+                assert!(prefix.error.is_none(), "{:?}", prefix.error);
