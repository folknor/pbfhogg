+//! Stage 2 produces the node prefix in source order on the same writer that
+//! stage 4 uses for ways and relations.
+
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::io::Write;
+use std::ops::Range;
+use std::os::unix::fs::FileExt as _;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Arc, Condvar, Mutex, PoisonError};
+
+use super::blob_meta::BlobMeta;
+use super::keys::{Family, NodeKeyLayout, NodeSpans};
+use crate::blob_meta::AscendingTally;
+use crate::block_builder::{BlockBuilder, OwnedBlock};
+use crate::commands::split::Limits;
+use crate::commands::{ensure_node_capacity_local, flush_local};
+use crate::error::{Error, Result};
+use crate::idset::IdSet;
+use crate::owned::{dense_node_metadata, element_metadata};
+use crate::writer::PbfWriter;
+use crate::{Element, ElementKind, PrimitiveBlock};
+
+use super::super::Stats;
+
+pub(super) type OutputWriter = PbfWriter<crate::file_writer::FileWriter>;
+
+/// The old stage 4 whole-blob skip trusts the tag and ID claims. Missing
+/// tagdata is represented by `has_tags == true` and needs a payload decode.
+pub(super) fn keep_node_blob(meta: &BlobMeta, members: Option<&IdSet>) -> bool {
+    meta.has_tags || members.is_some_and(|ids| ids.any_in_numeric_range(meta.min_id, meta.max_id))
+}
+
+pub(super) struct NodePrefix<W: Write = crate::file_writer::FileWriter> {
+    pub writer: Result<PbfWriter<W>>,
+    /// Deferred to stage 4, after stage 2 finishes checking the join.
+    pub error: Option<Error>,
+    pub stats: Stats,
+}
+
+/// A coordinate bucket and its contiguous run of node output positions.
+pub(super) struct BucketWork {
+    pub bucket: Option<usize>,
+    pub output: Range<usize>,
+}
+
+/// The first nonempty request bucket touching a blob owns its output.
+/// This gives each repeated read of a straddler the same owner. The
+/// owner order is file order (negative-family buckets come first);
+/// blobs untouched by the join go immediately before the next owner,
+/// or at the end, with an output-only job for each.
+pub(super) fn bucket_work(
+    counts: &[u64],
+    layout: &NodeKeyLayout,
+    spans: &NodeSpans,
+    node_count: usize,
+) -> Result<Vec<BucketWork>> {
+    let mut buckets: Vec<_> = counts
+        .iter()
+        .enumerate()
+        .filter_map(|(i, &count)| (count != 0).then_some(i))
+        .collect();
+    buckets.sort_by_key(|&i| {
+        layout
+            .bucket(i)
+            .map(|(family, lo, _)| (family == Family::Pos, lo))
+    });
+    let mut owners = vec![None; node_count];
+    let mut first_touched = vec![node_count; buckets.len() + 1];
+    for (owner, &bucket) in buckets.iter().enumerate() {
+        let Some((family, lo, hi)) = layout.bucket(bucket) else {
+            continue;
+        };
+        let spans = spans.of(family);
+        let start = spans.partition_point(|s| s.hi < lo);
+        let end = spans.partition_point(|s| s.lo < hi);
+        for span in &spans[start..end] {
+            let slot = owners
+                .get_mut(span.blob as usize)
+                .ok_or_else(|| Error::internal("stage2: a key span names no node blob"))?;
+            if slot.is_none() {
+                *slot = Some(owner);
+                first_touched[owner] = first_touched[owner].min(span.blob as usize);
+            }
+        }
+    }
+    let mut next_owner = buckets.len();
+    for owner in owners.iter_mut().rev() {
+        next_owner = *owner.get_or_insert(next_owner);
+    }
+    if !owners.is_sorted() {
+        return Err(Error::internal(
+            "stage2: node output owners are out of file order",
+        ));
+    }
+
+    let mut start = 0;
+    let mut work = Vec::with_capacity(buckets.len() + 1);
+    for (owner, bucket) in buckets.into_iter().map(Some).chain([None]).enumerate() {
+        let end = start + owners[start..].partition_point(|&i| i == Some(owner));
+        // Output-only jobs stay parallel even when there are few way refs
+        // or none. Each has one source blob's work and the same byte gate.
+        let first = first_touched[owner].min(end);
+        for index in start..first {
+            work.push(BucketWork {
+                bucket: None,
+                output: index..index + 1,
+            });
+        }
+        if bucket.is_some() {
+            work.push(BucketWork {
+                bucket,
+                output: first..end,
+            });
+        }
+        start = end;
+    }
+    Ok(work)
+}
+
+enum NodeFrame {
+    Raw(Vec<u8>),
+    Rebuilt(Vec<OwnedBlock>),
+    Skipped,
+}
+
+pub(super) struct NodeResult {
+    frame: NodeFrame,
+    stats: Stats,
+}
+
+impl NodeResult {
+    pub fn raw(frame: Vec<u8>, count: u64) -> Self {
+        Self {
+            frame: NodeFrame::Raw(frame),
+            stats: Stats {
+                nodes_read: count,
+                nodes_written: count,
+                blobs_passthrough: 1,
+                ..Stats::default()
+            },
+        }
+    }
+
+    pub fn skipped(count: u64) -> Self {
+        Self {
+            frame: NodeFrame::Skipped,
+            stats: Stats {
+                nodes_read: count,
+                nodes_dropped: count,
+                ..Stats::default()
+            },
+        }
+    }
+}
+
+pub(super) fn read_frame(file: &File, meta: &BlobMeta) -> std::io::Result<(Vec<u8>, usize)> {
+    // Both offsets came from the same header read, so their difference
+    // is the bounded length prefix and BlobHeader.
+    #[allow(clippy::cast_possible_truncation)]
+    let body = (meta.data_offset - meta.frame_offset) as usize;
+    let mut frame = vec![0; body + meta.data_size];
+    file.read_exact_at(&mut frame, meta.frame_offset)?;
+    Ok((frame, body))
+}
+
+pub(super) struct NodeAssembler {
+    builder: BlockBuilder,
+    pool: Arc<crate::blob::DecompressPool>,
+    st_scratch: Vec<(u32, u32)>,
+    gr_scratch: Vec<(u32, u32)>,
+}
+
+impl NodeAssembler {
+    pub fn new(invocation: &crate::host::Recorder) -> Self {
+        Self {
+            builder: BlockBuilder::new(),
+            pool: crate::blob::DecompressPool::new(invocation),
+            st_scratch: Vec::new(),
+            gr_scratch: Vec::new(),
+        }
+    }
+
+    pub fn rebuild(
+        &mut self,
+        bytes: &mut Vec<u8>,
+        meta: &BlobMeta,
+        members: Option<&IdSet>,
+        limits: &Limits,
+    ) -> Result<NodeResult> {
+        let result = self.rebuild_inner(std::mem::take(bytes), meta, members, limits);
+        // Parsing extends the owned buffer in place. The block returns it
+        // when it drops, so the next scanner read can reuse the allocation.
+        *bytes = self.pool.get();
+        crate::retention::release_scratch(&mut self.st_scratch);
+        crate::retention::release_scratch(&mut self.gr_scratch);
+        // A failed assembly may have left partially accumulated elements.
+        if result.is_err() {
+            self.builder = BlockBuilder::new();
+        }
+        result
+    }
+
+    fn rebuild_inner(
+        &mut self,
+        bytes: Vec<u8>,
+        meta: &BlobMeta,
+        members: Option<&IdSet>,
+        limits: &Limits,
+    ) -> Result<NodeResult> {
+        let block = PrimitiveBlock::from_vec_pooled_with_scratch(
+            bytes,
+            &self.pool,
+            &mut self.st_scratch,
+            &mut self.gr_scratch,
+        )?;
+        block.refuse_foreign_kind(Some(ElementKind::Node))?;
+
+        let mut blocks = Vec::new();
+        let mut tally = AscendingTally::default();
+        let mut stats =
+            assemble_block(&block, &mut self.builder, &mut blocks, members, &mut tally)?;
+        crate::blob_meta::hold_claim(
+            &tally,
+            &meta.claim(),
+            super::blob_meta::EXTERNAL_ORDER,
+            || {
+                block.elements_skip_metadata().map(|e| match e {
+                    Element::DenseNode(n) => n.id(),
+                    Element::Node(n) => n.id(),
+                    Element::Way(w) => w.id(),
+                    Element::Relation(r) => r.id(),
+                })
+            },
+        )?;
+        stats.blobs_decoded = 1;
+        flush_local(&mut self.builder, &mut blocks)?;
+        let (blocks, _) = super::super::fit_output(blocks, limits)?;
+        Ok(NodeResult {
+            frame: NodeFrame::Rebuilt(blocks),
+            stats,
+        })
+    }
+}
+
+type Pending = Result<NodeResult>;
+
+fn buffered_bytes(item: &Pending) -> usize {
+    let payload = match item.as_ref().map(|output| &output.frame) {
+        Ok(NodeFrame::Raw(bytes)) => bytes.capacity(),
+        Ok(NodeFrame::Rebuilt(blocks)) => {
+            blocks.capacity() * size_of::<OwnedBlock>()
+                + blocks
+                    .iter()
+                    .map(|block| {
+                        block.bytes.capacity() + block.tagdata.as_ref().map_or(0, Vec::capacity)
+                    })
+                    .sum::<usize>()
+        }
+        Ok(NodeFrame::Skipped) | Err(_) => 0,
+    };
+    payload.saturating_add(size_of::<(usize, usize, Pending)>())
+}
+
+struct OrderedState<W: Write> {
+    prefix: NodePrefix<W>,
+    next: usize,
+    bytes: usize,
+    peak: usize,
+    pending: BTreeMap<usize, (usize, Pending)>,
+    stopped: bool,
+}
+
+/// Only out-of-order results use queue credit. The head writes directly, so
+/// it can always make progress, even for a frame larger than the budget.
+/// Each stage 2 worker can also hold one completed source blob while waiting
+/// for credit. The writer retains its own ordinary pipeline bounds.
+pub(super) struct OrderedNodes<W: Write = crate::file_writer::FileWriter> {
+    budget: usize,
+    state: Mutex<OrderedState<W>>,
+    room: Condvar,
+    wait_ns: AtomicU64,
+}
+
+impl<W: Write> OrderedNodes<W> {
+    pub fn new(writer: Result<PbfWriter<W>>, budget: usize) -> Self {
+        Self {
+            budget,
+            state: Mutex::new(OrderedState {
+                stopped: writer.is_err(),
+                prefix: NodePrefix {
+                    writer,
+                    error: None,
+                    stats: Stats::default(),
+                },
+                next: 0,
+                bytes: 0,
+                peak: 0,
+                pending: BTreeMap::new(),
+            }),
+            room: Condvar::new(),
+            wait_ns: AtomicU64::new(0),
+        }
+    }
+
+    pub fn submit(&self, index: usize, item: Pending) -> Result<()> {
+        let bytes = buffered_bytes(&item);
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let mut wait = None;
+        while !state.stopped && index > state.next && bytes > self.budget - state.bytes {
+            wait.get_or_insert_with(crate::counters::Stopwatch::start);
+            state = self
+                .room
+                .wait(state)
+                .unwrap_or_else(PoisonError::into_inner);
+        }
+        if let Some(wait) = wait {
+            self.wait_ns.fetch_add(wait.elapsed_ns(), Relaxed);
+        }
+        if state.stopped {
+            return Ok(());
+        }
+        if index < state.next || state.pending.contains_key(&index) {
+            return Err(Error::internal("stage2: duplicate node output owner"));
+        }
+        if index > state.next {
+            state.bytes += bytes;
+            state.peak = state.peak.max(state.bytes);
+            state.pending.insert(index, (bytes, item));
+            return Ok(());
+        }
+        state.write(item);
+        while !state.stopped {
+            let next = state.next;
+            let Some((bytes, item)) = state.pending.remove(&next) else {
+                break;
+            };
+            state.bytes -= bytes;
+            state.write(item);
+        }
+        drop(state);
+        self.room.notify_all();
+        Ok(())
+    }
+
+    pub fn stop(&self) {
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        state.stop();
+        drop(state);
+        self.room.notify_all();
+    }
+
+    pub fn finish(self, count: usize, host: &crate::host::Recorder) -> Result<NodePrefix<W>> {
+        let state = self
+            .state
+            .into_inner()
+            .unwrap_or_else(PoisonError::into_inner);
+        let complete = state.next == count && state.pending.is_empty();
+        let failed = state.prefix.writer.is_err() || state.prefix.error.is_some();
+        if !complete && !failed {
+            return Err(Error::internal("stage2: incomplete node output prefix"));
+        }
+        host.counter("s2_node_output_pending_peak_bytes", state.peak);
+        host.counter("s2_node_output_wait_ns", self.wait_ns.into_inner());
+        Ok(state.prefix)
+    }
+}
+
+impl<W: Write> OrderedState<W> {
+    fn write(&mut self, item: Pending) {
+        let result = item.and_then(|item| {
+            self.prefix.stats.merge(&item.stats)?;
+            let Ok(writer) = &mut self.prefix.writer else {
+                return Err(Error::internal(
+                    "stage2: node output started without a writer",
+                ));
+            };
+            match item.frame {
+                NodeFrame::Raw(bytes) => writer.write_raw_owned(bytes)?,
+                NodeFrame::Rebuilt(blocks) => {
+                    for block in blocks {
+                        writer.write_primitive_block_owned(block)?;
+                    }
+                }
+                NodeFrame::Skipped => {}
+            }
+            Ok(())
+        });
+        if let Err(error) = result {
+            self.prefix.error = Some(error);
+            self.stop();
+        }
+        self.next += 1;
+    }
+
+    fn stop(&mut self) {
+        self.stopped = true;
+        self.pending.clear();
+        self.bytes = 0;
+    }
+}
+
+/// Re-encode the retained nodes with the original stage 4 builder.
+#[cfg_attr(feature = "hotpath", hotpath::measure)]
+#[allow(clippy::too_many_arguments, clippy::too_many_lines)]
+fn assemble_block(
+    block: &PrimitiveBlock,
+    bb: &mut BlockBuilder,
+    output: &mut Vec<OwnedBlock>,
+    relation_member_node_ids: Option<&IdSet>,
+    tally: &mut crate::blob_meta::AscendingTally,
+) -> crate::Result<Stats> {
+    let mut stats = Stats::default();
+
+    for element in block.elements() {
+        match &element {
+            Element::DenseNode(dn) => {
+                tally.add(dn.id());
+                stats.nodes_read += 1;
+                let has_tags = dn.tags().next().is_some();
+                if has_tags || relation_member_node_ids.is_some_and(|ids| ids.get(dn.id())) {
+                    ensure_node_capacity_local(bb, output)?;
+                    let meta = dense_node_metadata(dn)?;
+                    bb.add_node_dense(
+                        dn.id(),
+                        dn.decimicro_lat()?,
+                        dn.decimicro_lon()?,
+                        dn.tags(),
+                        meta.as_ref(),
+                    );
+                    stats.nodes_written += 1;
+                } else {
+                    stats.nodes_dropped += 1;
+                }
+            }
+            Element::Node(n) => {
+                tally.add(n.id());
+                stats.nodes_read += 1;
+                let has_tags = n.tags().next().is_some();
+                if has_tags || relation_member_node_ids.is_some_and(|ids| ids.get(n.id())) {
+                    ensure_node_capacity_local(bb, output)?;
+                    let meta = element_metadata(ElementKind::Node, n.id(), &n.info())?;
+                    bb.add_node_partial(
+                        n.id(),
+                        n.decimicro_lat()?,
+                        n.decimicro_lon()?,
+                        n.tags(),
+                        meta.as_ref(),
+                    );
+                    stats.nodes_written += 1;
+                } else {
+                    stats.nodes_dropped += 1;
+                }
+            }
+            // Only node blobs are decoded here (relation blobs pass through,
+            // way blobs are reframed), and the caller refused a block holding
+            // another kind under the node claim.
+            Element::Way(_) | Element::Relation(_) => {
+                return Err(Error::internal(
+                    "altw external stage 4: a decoded node blob holds a way or relation \
+                     its kind check should have refused",
+                ));
+            }
+        }
+    }
+
+    Ok(stats)
+}
