+
+    #[test]
+    fn a_blob_in_both_key_families_has_one_owner() {
+        let plan = KeyPlan {
+            threshold: 1,
+            pos: FamilyPlan {
+                buckets: 2,
+                max_key: 20,
+            },
+            neg: FamilyPlan {
+                buckets: 2,
+                max_key: 20,
+            },
+            compact: true,
+        };
+        let span = |lo, hi, blob| KeySpan {
+            lo,
+            hi,
+            count: 2,
+            blob,
+        };
+        let spans = NodeSpans {
+            neg: vec![span(1, 3, 0), span(8, 15, 1)],
+            pos: vec![span(3, 8, 1), span(18, 20, 2)],
+        };
+        let layout = NodeKeyLayout::new(&plan, &spans);
+        let work = bucket_work(&[1, 0, 1, 1], &layout, &spans, 3).unwrap();
+        let actual: Vec<_> = work.into_iter().map(|w| (w.bucket, w.output)).collect();
+        assert_eq!(
+            actual,
+            [
+                (Some(2), 0..2),
+                (Some(3), 2..2),
+                (Some(0), 2..2),
+                (None, 2..3)
+            ]
+        );
+    }
+
+    #[test]
+    fn full_reorder_budget_allows_the_oversize_head_and_preserves_order() {
+        let recorder = crate::host::Host::for_tests();
+        let host = recorder.entered();
+        let last = Ok(NodeResult::raw(vec![3], 1));
+        let budget = buffered_bytes(&last);
+        let writer = PbfWriter::new(Vec::new(), crate::write::compression::Compression::None);
+        let ordered = OrderedNodes::new(Ok(writer), budget);
+        ordered.submit(2, last).unwrap();
+        ordered
+            .submit(0, Ok(NodeResult::raw(vec![1; budget + 1], 1)))
+            .unwrap();
+        ordered.submit(1, Ok(NodeResult::raw(vec![2], 1))).unwrap();
+
+        let prefix = ordered.finish(3, &host.invocation).unwrap();
