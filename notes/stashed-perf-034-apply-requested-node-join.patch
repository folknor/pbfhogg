+pub(super) struct NodeRequest {
+    pub id: i64,
+    pub ordinal: usize,
+}
+
+/// Canonically sorted by OSM ID, including zero and signed IDs.
+pub(super) struct BaseRequests {
+    nodes: Vec<NodeRequest>,
+}
+
+impl BaseRequests {
+    pub(super) fn len(&self) -> usize {
+        self.nodes.len()
+    }
+
+    /// Indexdata stores numeric bounds, while requests follow canonical
+    /// order: zero, negatives by increasing magnitude, then positives.
+    /// A range spanning zero into the positives needs two slices. The
+    /// first runs from zero through min (only zero when min is zero), and
+    /// the second runs from one through max. Neither contains the more
+    /// negative IDs between the slices.
+    pub(super) fn in_blob(&self, range: Option<(i64, i64)>) -> impl Iterator<Item = &NodeRequest> {
+        let (first, second) = match range {
+            None => (&self.nodes[..], &[][..]),
+            Some((min, max)) if min <= 0 && max > 0 => {
+                (self.in_order(0, min), self.in_order(1, max))
             }
+            Some((min, max)) => (
+                self.in_order(blob_osm_first_id(min, max), blob_osm_last_id(min, max)),
+                &[][..],
+            ),
+        };
+        first.iter().chain(second)
+    }
+
+    fn in_order(&self, first: i64, last: i64) -> &[NodeRequest] {
+        let start = self.nodes.partition_point(|r| !osm_id_le(first, r.id));
+        let len = self.nodes[start..].partition_point(|r| osm_id_le(r.id, last));
+        &self.nodes[start..start + len]
+    }
+}
+
+/// Shared coordinate slots and the ordinals for each OSC way, in ref order.
+/// Node workers fill slots before sending their drain items. The barrier
+/// publishes the table after those items have been processed. Workers and
+/// the drain then use it to encode OSC ways.
+pub(super) struct WayLocations {
+    coords: Vec<AtomicU64>,
+    way_ordinals: Vec<usize>,
+    way_offsets: Vec<usize>,
+}
+
+impl WayLocations {
+    pub(super) fn len(&self) -> u64 {
+        self.coords.len() as u64
+    }
+
+    pub(super) fn resolved(&self) -> u64 {
+        self.coords
+            .iter()
+            .filter(|slot| slot.load(Ordering::Relaxed) != 0)
+            .count() as u64
+    }
+
+    /// The caller checks the coordinate before packing it. An identical
+    /// duplicate counts once, and conflicting records have no winner.
+    pub(super) fn record_base(&self, request: &NodeRequest, packed: u64) -> Result<()> {
+        match self.coords[request.ordinal].compare_exchange(
+            0,
+            packed,
+            Ordering::Relaxed,
+            Ordering::Relaxed,
+        ) {
+            Ok(_) => Ok(()),
+            Err(prev) if prev == packed => Ok(()),
+            Err(prev) => Err(conflicting_node(request.id, prev, packed)),
+        }
+    }
+
+    pub(super) fn for_way(&self, way: usize, ref_count: usize) -> Result<Vec<(i32, i32)>> {
+        let ordinals = &self.way_ordinals[self.way_offsets[way]..self.way_offsets[way + 1]];
+        if ordinals.len() != ref_count {
+            return Err(Error::internal(
+                "apply-changes: OSC way refs and coordinate slots differ",
+            ));
         }
+        Ok(ordinals
+            .iter()
+            .map(|&ordinal| {
+                coord_pack::unpack(self.coords[ordinal].load(Ordering::Relaxed)).unwrap_or((0, 0))
+            })
+            .collect())
+    }
+}
+
+#[cold]
+fn conflicting_node(id: i64, previous: u64, incoming: u64) -> Error {
+    let (Some((lat_a, lon_a)), Some((lat_b, lon_b))) =
+        (coord_pack::unpack(previous), coord_pack::unpack(incoming))
+    else {
+        return Error::internal("apply-changes: conflicting coordinate slots must both be present");
+    };
+    Error::invalid_data(format!(
+        "node {id} occurs more than once in the base with different \
+         coordinates (lat {lat_a}, lon {lon_a} and lat {lat_b}, lon {lon_b} in decimicrodegrees). \
+         Refusing to choose one as an inline way location."
+    ))
+}
