+                }
+                0
+            };
+            coords.push(AtomicU64::new(packed));
+        }
+
+        let mut way_ordinals = Vec::new();
+        let mut way_offsets = Vec::with_capacity(way_count + 1);
+        for i in 0..way_count {
+            way_offsets.push(way_ordinals.len());
+            for id in diff.way(i).refs() {
+                let ordinal = ids
+                    .binary_search_by_key(&osm_id_ordinal(id), |&x| osm_id_ordinal(x))
+                    .map_err(|_| {
+                        Error::internal(format!("apply-changes: no coordinate slot for node {id}"))
+                    })?;
+                way_ordinals.push(ordinal);
+            }
+        }
+        way_offsets.push(way_ordinals.len());
