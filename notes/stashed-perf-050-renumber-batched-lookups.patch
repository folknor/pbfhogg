+fn reframe_way_refs<const TIMED: bool>(
+    data: &[u8],
+    way_id: i64,
+    nodes: &IdSpace<'_>,
+    batch: &mut WayRefs,
+    out: &mut Vec<u8>,
+) -> crate::Result<u64> {
+    out.clear();
+    let mut orphans = 0;
+    let mut prev_old = 0_i64;
+    let mut prev_new = 0_i64;
+    let mut cursor = Cursor::new(data);
+    while !cursor.is_empty() {
+        let mut used = 0_usize;
+        let mut decode_error = None;
+        for id in &mut batch.old {
+            if cursor.is_empty() {
+                break;
+            }
+            match cursor.read_sint64() {
+                Ok(delta) => {
+                    prev_old = prev_old.wrapping_add(delta);
+                    *id = prev_old;
+                    // Bounded by the batch's length.
+                    used = used.wrapping_add(1);
+                }
+                Err(err) => {
+                    decode_error = Some(err);
+                    break;
+                }
+            }
+        }
+
+        let old = &batch.old[..used];
+        let ranks = &mut batch.ranks[..used];
+        let timer = TIMED.then(Stopwatch::start);
+        for (&id, rank) in old.iter().zip(ranks.iter_mut()) {
+            *rank = nodes.set.canonical_rank_if_set(id);
+        }
+        if let Some(timer) = timer {
+            batch.lookup_ns = batch.lookup_ns.saturating_add(timer.elapsed_ns());
+        }
+
+        for (&id, &rank) in old.iter().zip(ranks.iter()) {
+            let (new, is_orphan) = nodes
+                .resolve_rank(id, rank)
+                .map_err(|err| err.context(format!("in way {way_id}")))?;
+            if is_orphan {
+                orphans = inc(orphans)?;
