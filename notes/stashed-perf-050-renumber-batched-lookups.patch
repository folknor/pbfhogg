+impl RankedPage {
+    fn new(words: &[AtomicU64], before: &mut u32) -> Self {
+        let first = words[0].load(Relaxed);
+        if matches!(first, 0 | u64::MAX)
+            && words[1..].iter().all(|word| word.load(Relaxed) == first)
+        {
+            let rank = *before;
+            if first == 0 {
+                return Self::Empty(rank);
+            }
+            *before += PAGE_BITS;
+            return Self::Full(rank);
+        }
+        Self::Words(
+            words
+                .iter()
+                .map(|word| {
+                    let bits = word.load(Relaxed);
+                    let pair = RankedWord {
+                        bits,
+                        before: *before,
+                    };
+                    *before += bits.count_ones();
+                    pair
+                })
+                .collect(),
+        )
+    }
