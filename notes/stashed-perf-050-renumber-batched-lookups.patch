+/// Align each pair so it cannot straddle a cache line.
+#[repr(C, align(16))]
+struct RankedWord {
+    bits: u64,
+    before: u32,
+}
+
+impl RankedWord {
+    #[inline]
+    fn rank(&self, bit: u64) -> u32 {
+        self.before + (self.bits & (bit - 1)).count_ones()
+    }
