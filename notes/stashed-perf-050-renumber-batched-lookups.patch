+impl InterleavedChunk {
+    fn new<'a>(pages: impl Iterator<Item = (usize, &'a [AtomicU64])>) -> (Self, u64) {
+        let mut directory = Vec::with_capacity(PAGES_PER_CHUNK);
+        let mut before = 0;
+        for (index, words) in pages {
+            directory.resize_with(index, || RankedPage::Empty(before));
